odoo.define('@html_editor/../tests/selection_placeholder.test', ['@odoo/hoot', '@html_editor/../tests/_helpers/editor', '@html_editor/../tests/_helpers/format', '@odoo/hoot-dom', '@html_editor/../tests/_helpers/user_actions', '@html_editor/../tests/_helpers/selection', '@html_editor/utils/dom_traversal', '@html_editor/utils/dom_info', '@html_editor/utils/html'], function (require) {
'use strict';
let __exports = {};
const { expect, test } = require("@odoo/hoot");
const { testEditor } = require("@html_editor/../tests/_helpers/editor");
const { unformat } = require("@html_editor/../tests/_helpers/format");
const { animationFrame, press, tick } = require("@odoo/hoot-dom");
const { insertText, simulateArrowKeyPress, splitBlock } = require("@html_editor/../tests/_helpers/user_actions");
const { getContent } = require("@html_editor/../tests/_helpers/selection");
const { closestElement } = require("@html_editor/utils/dom_traversal");
const { isTableCell } = require("@html_editor/utils/dom_info");
const { parseHTML } = require("@html_editor/utils/html");

const pressArrowKey = async (editor, key) => {
    const selection = editor.shared.selection.getSelectionData().deepEditableSelection;
    if (
        !key.includes("Shift") &&
        selection.isCollapsed &&
        closestElement(selection.anchorNode, isTableCell)
    ) {
        // Since the selection is in a table, the table plugin handles the
        // arrow key so we use `press` instead of `simulateArrowKeyPress`
        // (which would then change the selection twice).
        // TODO: detect this without relying on implementation if possible.
        await press(key);
    } else {
        await simulateArrowKeyPress(editor, key);
        // Wait an extra tick in case of selection in root correction, so the
        // extra selectionchange event is triggered.
        await tick();
    }
    // Wait for selectionchange event.
    await tick();
};

