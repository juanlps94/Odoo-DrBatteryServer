            throw new Error(`StoreRelation ${this.name} cannot be used with records`);
        }

        return new this.constructor(
            target,
            makeKwArgs({
                fields: this.fields,
                value: this.value,
                predicate: this.predicate,
                as_thread: this.as_thread,
            })
        );
