    }
    fn() {
        expect.step("base.fn");
    }
    async asyncFn() {
        // also check this binding
        expect.step(`base.${this.str}`);
    }
    get dynamic() {
        return this._dynamic;
    }
    set dynamic(value) {
        this._dynamic = value;
    }
