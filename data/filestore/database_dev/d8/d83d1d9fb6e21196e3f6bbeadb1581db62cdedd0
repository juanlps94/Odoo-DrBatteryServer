                platform: "youtube",
                embed_url: "https://www.youtube.com/embed/qxb74CMR748?rel=0&autoplay=0",
                params: {
                    rel: 0,
                    autoplay: 0,
                },
            };
        } else {
            return {
                video_id: "gbE3azm_Io0",
                platform: "youtube",
                embed_url: "https://www.youtube.com/embed/gbE3azm_Io0?rel=0&autoplay=0",
                params: {
                    rel: 0,
                    autoplay: 0,
                },
            };
        }
    });

    // Insert video
