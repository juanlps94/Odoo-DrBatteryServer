        { ...baseCtx, active_id: 1 },
        { ...baseCtx, active_id: 2 },
        { ...baseCtx, active_ids: [1, 2] },
        { ...baseCtx, active_ids: [1, 2, 3] },
        { ...baseCtx, active_model: "a" },
        { ...baseCtx, active_model: "b" },
    ]);
