                        const fiber = root.node.fiber;
                        const fiberComplete = fiber.complete;
                        fiber.complete = function () {
                            expect.step("html prop suppression");
                            asyncControl.resolve();
                            fiberComplete.call(this);
                        };
                    }
                    return result;
                };
                return root;
