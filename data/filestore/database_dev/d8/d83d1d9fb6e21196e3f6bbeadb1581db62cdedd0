    expect(`.my_widget`).toHaveText("MyWidget 1");

    def.resolve({ test: 2 });
    await animationFrame();
    expect(`.o_last_breadcrumb_item`).toHaveText("second record");
    expect(`.my_widget`).toHaveText("MyWidget 2");
    expect.verifySteps(["get_special_data 42"]);
});

