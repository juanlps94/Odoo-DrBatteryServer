describe("symmetrical selection", () => {
    test("select cells symmetrically when pressing shift + arrow key", async () => {
        const { el } = await setupEditor(
            unformat(
                `<table class="table table-bordered o_table">
                    <tbody>
                        <tr><td>[]<br></td><td><br></td><td><br></td></tr>
                        <tr><td><br></td><td><br></td><td><br></td></tr>
                    </tbody>
                </table>`
            )
