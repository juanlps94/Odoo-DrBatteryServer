function applyGenericPatch(Klass, tag) {
    return patch(Klass.prototype, {
        setup() {
            super.setup();
            expect.step(`${tag}.setup`);
        },
        fn() {
            super.fn();
            expect.step(`${tag}.fn`);
        },
        async asyncFn() {
            await Promise.resolve();
            await super.asyncFn(...arguments);
            // also check this binding
            expect.step(`${tag}.${this.str}`);
        },
    });
}

