                    expect.step(blob);
                }
            }
        },
    });
    setCellContent(model, "A1", `=ODOO.ACCOUNT.GROUP("income")`);
    setCellContent(model, "A2", `=ODOO.BALANCE(A1, 2022)`); // batched only when A1 resolves
