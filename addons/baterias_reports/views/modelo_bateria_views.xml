<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree para Modelo Batería -->
    <record id="view_modelo_bateria_tree" model="ir.ui.view">
        <field name="name">bateria.modelo.tree</field>
        <field name="model">bateria.modelo</field>
        <field name="arch" type="xml">
            <tree string="Modelos de Batería">
                <field name="name"/>
                <field name="codigo"/>
                <field name="voltaje"/>
                <field name="capacidad"/>
                <field name="precio_venta_bs"/>
                <field name="stock_actual"/>
                <field name="activo"/>
            </tree>
        </field>
    </record>
    
    <!-- Vista Form para Modelo Batería -->
    <record id="view_modelo_bateria_form" model="ir.ui.view">
        <field name="name">bateria.modelo.form</field>
        <field name="model">bateria.modelo</field>
        <field name="arch" type="xml">
            <form string="Modelo de Batería">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="codigo"/>
                            <field name="activo"/>
                        </group>
                        <group>
                            <field name="voltaje"/>
                            <field name="capacidad"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="precio_venta_bs"/>
                        <field name="stock_actual"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Acción para Modelo Batería -->
    <record id="action_modelo_bateria" model="ir.actions.act_window">
        <field name="name">Modelos de Batería</field>
        <field name="res_model">bateria.modelo</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>