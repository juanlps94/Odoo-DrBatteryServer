<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_cuenta_pagar_pdf" model="ir.actions.report">
        <field name="name">Reporte de Cuentas por Pagar</field>
        <field name="model">bateria.cuenta.pagar</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bateria_reportes.template_cuenta_pagar</field>
        <field name="report_file">bateria_reportes.template_cuenta_pagar</field>
        <field name="print_report_name">'CxP_%s' % (context_timestamp(datetime.datetime.now()).strftime('%Y%m%d'))</field>
        <field name="print_report_name">'Cuentas_por_Pagar'</field>
        <field name="binding_type">report</field>
    </record>

    <template id="template_cuenta_pagar">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 16px;">
                    
                    <t t-set="total_deuda_usd" t-value="sum([o.monto_total for o in docs if o.moneda == 'usd'])"/>
                    <t t-set="total_pagado_usd" t-value="sum([o.monto_pagado for o in docs if o.moneda == 'usd'])"/>
                    <t t-set="total_pendiente_usd" t-value="sum([o.saldo_pendiente for o in docs if o.moneda == 'usd'])"/>
                    
                    <t t-set="total_deuda_bs" t-value="sum([o.monto_total for o in docs if o.moneda == 'bs'])"/>
                    <t t-set="total_pagado_bs" t-value="sum([o.monto_pagado for o in docs if o.moneda == 'bs'])"/>
                    <t t-set="total_pendiente_bs" t-value="sum([o.saldo_pendiente for o in docs if o.moneda == 'bs'])"/>

                    <div class="text-center mt-4 mb-4">
                        <h2 style="font-weight: bold;">Reporte de Cuentas por Pagar (Compras)</h2>
                        <p class="text-muted">Generado el: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/></p>
                    </div>

                    <table class="table table-bordered mb-4">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th class="text-center">Resumen por Moneda</th>
                                <th class="text-right">Total Deuda</th>
                                <th class="text-right">Total Pagado</th>
                                <th class="text-right" style="color: #dc3545;">Saldo Pendiente</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><strong>Dólares ($)</strong></td>
                                <td class="text-right">$ <span t-esc="total_deuda_usd" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-right">$ <span t-esc="total_pagado_usd" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-right" style="color: #dc3545; font-weight: bold;">$ <span t-esc="total_pendiente_usd" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                            <tr>
                                <td><strong>Bolívares (Bs)</strong></td>
                                <td class="text-right">Bs <span t-esc="total_deuda_bs" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-right">Bs <span t-esc="total_pagado_bs" t-options='{"widget": "float", "precision": 2}'/></td>
                                <td class="text-right" style="color: #dc3545; font-weight: bold;">Bs <span t-esc="total_pendiente_bs" t-options='{"widget": "float", "precision": 2}'/></td>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-striped table-sm">
                        <thead style="background-color: #343a40; color: white;">
                            <tr>
                                <th>Ref / Factura</th>
                                <th>Fecha</th>
                                <th>Proveedor</th>
                                <th>Condición</th>
                                <th class="text-right">Total</th>
                                <th class="text-right">Abonado</th>
                                <th class="text-right">Pendiente</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <tr>
                                    <td><strong><span t-field="doc.name"/></strong></td>
                                    <td><span t-field="doc.fecha" t-options='{"widget": "date"}'/></td>
                                    <td><span t-field="doc.proveedor"/></td>
                                    <td>
                                        <span t-if="doc.condicion_pago == 'contado'">Contado</span>
                                        <span t-if="doc.condicion_pago == 'credito_15'">Créd. 15 Días</span>
                                        <span t-if="doc.condicion_pago == 'credito_30'">Créd. 30 Días</span>
                                        <span t-if="doc.condicion_pago == 'credito_45'">Créd. 45 Días</span>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="doc.monto_total" t-options='{"widget": "float", "precision": 2}'/>
                                        <span t-if="doc.moneda == 'usd'">$</span><span t-else="">Bs</span>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="doc.monto_pagado" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                    <td class="text-right" style="font-weight: bold; color: #dc3545;">
                                        <span t-esc="doc.saldo_pendiente" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>