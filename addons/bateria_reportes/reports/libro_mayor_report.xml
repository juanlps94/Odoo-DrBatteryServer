<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_libro_mayor" model="ir.actions.report">
        <field name="name">Reporte de Libro Mayor</field>
        <field name="model">bateria.libro.mayor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bateria_reportes.reporte_libro_mayor_template</field>
        <field name="report_file">bateria_reportes.reporte_libro_mayor_template</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="reporte_libro_mayor_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 11px;">
                    
                    <div class="text-center mb-4">
                        <h2 style="color: #333; font-weight: bold; border-bottom: 2px solid #333; padding-bottom: 5px; display: inline-block;">REPORTE DE LIBRO MAYOR</h2>
                        
                        <p class="text-muted mt-2" style="font-size: 13px;">
                            <t t-if="context.get('fecha_inicio')">
                                Desde: <strong style="color: #000;"><span t-esc="context.get('fecha_inicio')"/></strong> - 
                                Hasta: <strong style="color: #000;"><span t-esc="context.get('fecha_fin')"/></strong><br/>
                                Banco / Caja: <strong style="color: #000; text-transform: uppercase;"><span t-esc="context.get('banco', 'TODOS')"/></strong>
                            </t>
                            <t t-else="">
                                Movimientos Históricos Completos
                            </t>
                        </p>
                    </div>

                    <table class="table table-sm table-bordered mt-4">
                        <thead style="background-color: #f0f0f0; color: #000;">
                            <tr>
                                <th class="text-center" style="width: 8%;">Fecha</th>
                                <th style="width: 12%;">Caja / Banco</th>
                                <th style="width: 13%;">Referencia</th>
                                <th style="width: 20%;">Concepto</th>
                                <th class="text-center" style="width: 8%;">Tipo</th>
                                <th class="text-center" style="width: 10%;">Estado</th>
                                <th style="width: 18%;">Motivo / Observación</th>
                                <th class="text-end" style="width: 11%;">Monto</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <tr>
                                    <td class="text-center" style="vertical-align: middle;"><span t-field="doc.fecha" t-options='{"widget": "date"}'/></td>
                                    <td style="vertical-align: middle;"><span t-field="doc.caja_id.name"/></td>
                                    <td style="vertical-align: middle;"><span t-field="doc.referencia"/></td>
                                    <td style="vertical-align: middle;"><span t-field="doc.concepto"/></td>
                                    <td class="text-center" style="vertical-align: middle;">
                                        <span t-if="doc.tipo_movimiento == 'ingreso'" style="color: #155724; font-weight: bold;">Ingreso (+)</span>
                                        <span t-if="doc.tipo_movimiento == 'egreso'" style="color: #721c24; font-weight: bold;">Egreso (-)</span>
                                    </td>
                                    <td class="text-center fw-bold" style="vertical-align: middle;">
                                        <span t-if="doc.estado == 'conciliado'" class="text-success" style="text-transform: uppercase; font-size: 10px;"><span t-field="doc.estado"/></span>
                                        <span t-if="doc.estado == 'pendiente'" class="text-warning" style="text-transform: uppercase; font-size: 10px;"><span t-field="doc.estado"/></span>
                                    </td>
                                    <td style="vertical-align: middle; color: #856404; font-size: 9px; font-weight: bold;">
                                        <span t-field="doc.motivo_pendiente"/>
                                    </td>
                                    <td class="text-end fw-bold" style="vertical-align: middle; font-size: 12px;">
                                        <span t-field="doc.monto" t-options='{"widget": "float", "precision": 2}'/> <span t-field="doc.moneda"/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <div class="mt-4 text-center text-muted" style="font-size: 10px;">
                        <p>Documento de control interno administrativo. Módulo de Auditoría Automática BDT.</p>
                        <p><strong>Generado el:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></p>
                    </div>

                </div>
            </t>
        </t>
    </template>
</odoo>