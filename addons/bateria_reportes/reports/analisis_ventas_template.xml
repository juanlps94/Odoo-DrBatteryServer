<odoo>
    <template id="analisis_ventas_template">
        <t t-call="web.external_layout">
            <main class="page">

                <h2>Reporte de Análisis de Ventas</h2>

                <table class="table table-sm table-bordered">
                    <thead>
                        <tr>
                            <th>Fecha Entrega</th>
                            <th>Pedido</th>
                            <th>Comercial</th>
                            <th>Compañía</th>
                            <th class="text-right">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="docs" t-as="o">
                            <tr>
                                <td>
                                    <span t-field="o.fecha_entrega"/>
                                </td>
                                <td>
                                    <span t-field="o.pedido_numero"/>
                                </td>
                                <td>
                                    <span t-field="o.comercial"/>
                                </td>
                                <td>
                                    <span t-field="o.compania"/>
                                </td>
                                <td class="text-right">
                                    <span t-field="o.total"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

            </main>
        </t>
    </template>
</odoo>
