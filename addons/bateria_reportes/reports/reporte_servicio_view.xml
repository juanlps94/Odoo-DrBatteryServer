<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_reporte_diario_servicios" model="ir.actions.report">
        <field name="name">Reporte de Pago de Servicios</field>
        <field name="model">bateria.pago.servicio</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bateria_reportes.reporte_diario_servicios_template</field>
        <field name="report_file">bateria_reportes.reporte_diario_servicios_template</field>
        <field name="binding_model_id" eval="False"/> 
    </record>

    <template id="reporte_diario_servicios_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center mt-4 mb-4">
                        <h2 style="color: #00529b; font-weight: bold;">Reporte de Pago de Servicios</h2>
                        <p style="font-size: 16px;">
                            <strong>Cierre Contable</strong>
                        </p>
                    </div>
                    
                    <table class="table table-sm table-striped mt-4" style="font-size: 12px;">
                        <thead style="background-color: #00529b; color: white;">
                            <tr>
                                <th>Fecha</th>
                                <th>Servicio</th>
                                <th>Descripción / Mes</th>
                                <th>Empresa Paga</th>
                                <th class="text-center">Moneda</th>
                                <th class="text-end">Base Imponible</th>
                                <th class="text-end">IVA (16%)</th>
                                <th class="text-end">Total Pagado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <tr>
                                    <td><span t-field="doc.fecha" t-options='{"widget": "date"}'/></td>
                                    <td><strong><span t-field="doc.servicio_id.name"/></strong></td>
                                    <td><span t-field="doc.name"/></td>
                                    <td>
                                        <span t-esc="dict(doc.fields_get(allfields=['empresa_paga'])['empresa_paga']['selection']).get(doc.empresa_paga, doc.empresa_paga)"/>
                                    </td>
                                    <td class="text-center fw-bold"><span t-esc="doc.moneda.upper()"/></td>
                                    <td class="text-end"><span t-field="doc.monto_base" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end"><span t-field="doc.monto_iva" t-options='{"widget": "float", "precision": 2}'/></td>
                                    <td class="text-end fw-bold text-success"><span t-field="doc.monto_total" t-options='{"widget": "float", "precision": 2}'/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                    
                    <div class="row justify-content-end mt-4">
                        <div class="col-6">
                            <table class="table table-sm table-borderless">
                                <tr class="border-top">
                                    <td style="font-size: 16px;"><strong>TOTAL SERVICIOS PAGADOS:</strong></td>
                                    <td class="text-end fw-bold text-success" style="font-size: 16px;">
                                        <span t-esc="sum(d.monto_total for d in docs)" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <record id="view_bateria_servicio_diario_wizard_form" model="ir.ui.view">
        <field name="name">bateria.servicio.reporte.wizard.form</field>
        <field name="model">bateria.servicio.reporte.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Servicios">
                <group>
                    <group>
                        <field name="fecha_inicio"/>
                    </group>
                    <group>
                        <field name="fecha_fin"/>
                    </group>
                </group>
                <footer>
                    <button string="🖨️ Generar PDF" name="action_generar_reporte" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bateria_servicio_diario_wizard" model="ir.actions.act_window">
        <field name="name">Reporte de Servicios</field>
        <field name="res_model">bateria.servicio.reporte.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bateria_reporte_servicios" 
              name="Reporte de Servicios" 
              parent="bateria_reportes.menu_bateria_root" 
              action="action_bateria_servicio_diario_wizard" 
              sequence="56"/>

</odoo>