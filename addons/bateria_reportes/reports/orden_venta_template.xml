<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_orden_venta_document">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 18px;"> 
                    
                    <t t-set="suma_total_usd" t-value="0"/>
                    <t t-set="suma_total_bs" t-value="0"/>
                    
                    <t t-set="productos_acumulados" t-value="{}"/>
                    <t t-set="billetes_acumulados" t-value="{}"/>
                    
                    <t t-set="pay_usd_efectivo" t-value="0"/>
                    <t t-set="pay_usd_zelle" t-value="0"/>
                    <t t-set="pay_usd_cashea" t-value="0"/>
                    <t t-set="pay_usd_punto" t-value="0"/>
                    
                    <t t-set="pay_bs_efectivo" t-value="0"/>
                    <t t-set="pay_bs_pagomovil" t-value="0"/>
                    <t t-set="pay_bs_transf" t-value="0"/>
                    <t t-set="pay_bs_punto" t-value="0"/>
                    <t t-set="pay_bs_cashea" t-value="0"/>
                    
                    <t t-set="total_vuelto_entregado" t-value="0"/>
                    <t t-set="total_ganancia_dia" t-value="0"/>
                    
                    <t t-foreach="docs" t-as="o">
                        <t t-if="o.condiciones_pago != 'canon'">
                            <t t-set="suma_total_usd" t-value="suma_total_usd + o.total_global_usd"/>
                            <t t-set="suma_total_bs" t-value="suma_total_bs + o.total_global_bs"/>
                        </t>
                        
                        <t t-set="total_vuelto_entregado" t-value="total_vuelto_entregado + o.vuelto_entregado_usd"/>
                        <t t-set="total_ganancia_dia" t-value="total_ganancia_dia + o.total_ganancia_usd"/>
                        
                        <t t-foreach="o.linea_ids" t-as="linea">
                            <t t-set="prod_name" t-value="linea.producto_id.nombre"/>
                            <t t-set="qty" t-value="linea.cantidad"/>
                            
                            <t t-if="prod_name in productos_acumulados">
                                <t t-set="dummy" t-value="productos_acumulados.update({prod_name: productos_acumulados[prod_name] + qty})"/>
                            </t>
                            <t t-else="">
                                <t t-set="dummy" t-value="productos_acumulados.update({prod_name: qty})"/>
                            </t>
                        </t>

                        <t t-foreach="o.billetes_vuelto_ids" t-as="b">
                            <t t-set="denom" t-value="b.denominacion"/>
                            <t t-if="denom in billetes_acumulados">
                                <t t-set="dummy" t-value="billetes_acumulados.update({denom: billetes_acumulados[denom] + b.cantidad})"/>
                            </t>
                            <t t-else="">
                                <t t-set="dummy" t-value="billetes_acumulados.update({denom: b.cantidad})"/>
                            </t>
                        </t>

                        <t t-foreach="o.pago_ids" t-as="p">
                            <t t-if="p.moneda == 'usd'">
                                <t t-if="p.tipo_pago == 'efectivo'"><t t-set="pay_usd_efectivo" t-value="pay_usd_efectivo + p.monto"/></t>
                                <t t-elif="p.tipo_pago == 'zelle'"><t t-set="pay_usd_zelle" t-value="pay_usd_zelle + p.monto"/></t>
                                <t t-elif="p.tipo_pago == 'cashea'"><t t-set="pay_usd_cashea" t-value="pay_usd_cashea + p.monto"/></t>
                                <t t-elif="p.tipo_pago == 'punto'"><t t-set="pay_usd_punto" t-value="pay_usd_punto + p.monto"/></t>
                            </t>
                            <t t-else="">
                                <t t-if="p.tipo_pago == 'efectivo'"><t t-set="pay_bs_efectivo" t-value="pay_bs_efectivo + p.monto"/></t>
                                <t t-elif="p.tipo_pago == 'pago_movil'"><t t-set="pay_bs_pagomovil" t-value="pay_bs_pagomovil + p.monto"/></t>
                                <t t-elif="p.tipo_pago == 'zelle'"><t t-set="pay_bs_transf" t-value="pay_bs_transf + p.monto"/></t>
                                <t t-elif="p.tipo_pago == 'punto'"><t t-set="pay_bs_punto" t-value="pay_bs_punto + p.monto"/></t>
                                <t t-elif="p.tipo_pago == 'cashea'"><t t-set="pay_bs_cashea" t-value="pay_bs_cashea + p.monto"/></t>
                            </t>
                        </t>
                    </t>

                    <div class="text-center mt-4 mb-4">
                        <h2 style="font-weight: bold; font-size: 32px;">Reporte Diario de Caja y Ganancia</h2>
                        <p style="font-size: 18px;" class="text-muted">Generado el: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y %H:%M')"/></p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-12">
                            <table class="table table-bordered" style="font-size: 18px; width: 96%; margin: 0 auto; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                                <thead class="thead-light">
                                    <tr style="background-color: #e9ecef;">
                                        <th colspan="3" class="text-center">RESUMEN DE CAJA Y COBRANZA</th>
                                    </tr>
                                    <tr>
                                        <th class="text-center" style="width: 33%; vertical-align: middle;">TOTAL VENDIDO Y GANANCIA</th>
                                        <th class="text-center" style="width: 33%; vertical-align: middle;">DESGLOSE DÓLARES ($)</th>
                                        <th class="text-center" style="width: 33%; vertical-align: middle;">DESGLOSE BOLÍVARES (Bs)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td valign="top" style="padding: 15px;">
                                            <div class="mb-2">Total Ventas ($): <strong style="color: green;"><span t-esc="suma_total_usd" t-options='{"widget": "monetary", "display_currency": user.company_id.currency_id}'/></strong></div>
                                            <div class="mb-2">Total Ventas (Bs): <strong style="color: blue;"><span t-esc="suma_total_bs" t-options='{"widget": "float", "precision": 2}'/></strong></div>
                                            <hr/>
                                            <div class="mb-2" style="font-size: 20px; font-weight: bold; color: purple;">
                                                Ganancia Neta: $ <span t-esc="total_ganancia_dia" t-options='{"widget": "float", "precision": 2}'/>
                                            </div>
                                            <div class="mt-2 text-muted">Operaciones: <strong><span t-esc="len(docs)"/></strong></div>
                                        </td>
                                        <td valign="top" style="padding: 15px;">
                                            <ul style="list-style: none; padding: 0; margin: 0;">
                                                <li t-if="pay_usd_efectivo > 0">Efectivo Recibido: <strong><span t-esc="pay_usd_efectivo" t-options='{"widget": "float", "precision": 2}'/></strong></li>
                                                
                                                <li t-if="total_vuelto_entregado > 0" class="text-danger mt-2 border-top pt-2">
                                                    Vuelto Entregado: <strong>- $<span t-esc="total_vuelto_entregado" t-options='{"widget": "float", "precision": 2}'/></strong>
                                                    <ul style="list-style: none; padding-left: 10px; margin: 5px 0 0 0; font-size: 15px;">
                                                        <t t-foreach="billetes_acumulados" t-as="denom">
                                                            <li>↳ <span t-esc="billetes_acumulados[denom]"/>x Billete de $<span t-esc="denom"/></li>
                                                        </t>
                                                    </ul>
                                                </li>
                                                
                                                <li t-if="pay_usd_efectivo > 0" class="text-success mt-2 border-top border-dark pt-2" style="font-size: 19px;">
                                                    <strong>CAJA NETO: $<span t-esc="pay_usd_efectivo - total_vuelto_entregado" t-options='{"widget": "float", "precision": 2}'/></strong>
                                                </li>
                                                <li t-if="pay_usd_zelle > 0" class="mt-3">Zelle: <strong><span t-esc="pay_usd_zelle" t-options='{"widget": "float", "precision": 2}'/></strong></li>
                                                <li t-if="pay_usd_cashea > 0">Cashea: <strong><span t-esc="pay_usd_cashea" t-options='{"widget": "float", "precision": 2}'/></strong></li>
                                                <li t-if="pay_usd_punto > 0">Punto: <strong><span t-esc="pay_usd_punto" t-options='{"widget": "float", "precision": 2}'/></strong></li>
                                            </ul>
                                        </td>
                                        <td valign="top" style="padding: 15px;">
                                            <ul style="list-style: none; padding: 0; margin: 0;">
                                                <li t-if="pay_bs_pagomovil > 0">Pago Móvil: <strong><span t-esc="pay_bs_pagomovil" t-options='{"widget": "float", "precision": 2}'/></strong></li>
                                                <li t-if="pay_bs_efectivo > 0">Efectivo: <strong><span t-esc="pay_bs_efectivo" t-options='{"widget": "float", "precision": 2}'/></strong></li>
                                                <li t-if="pay_bs_transf > 0">Transf: <strong><span t-esc="pay_bs_transf" t-options='{"widget": "float", "precision": 2}'/></strong></li>
                                                <li t-if="pay_bs_punto > 0">Punto: <strong><span t-esc="pay_bs_punto" t-options='{"widget": "float", "precision": 2}'/></strong></li>
                                                <li t-if="pay_bs_cashea > 0">Cashea: <strong><span t-esc="pay_bs_cashea" t-options='{"widget": "float", "precision": 2}'/></strong></li>
                                            </ul>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #f8f9fa;">
                                        <td colspan="3" class="text-center"><strong>INVENTARIO VENDIDO</strong></td>
                                    </tr>
                                    <tr>
                                        <td colspan="3" style="padding: 10px 40px;">
                                            <ul style="list-style-type: none; padding: 0; margin: 0; width: 100%;">
                                                <t t-foreach="productos_acumulados" t-as="prod">
                                                    <li style="padding: 6px 0; border-bottom: 1px solid #eee;">
                                                        <strong style="color: #333;"><span t-esc="int(productos_acumulados[prod])"/>x</strong> <span t-esc="prod" style="margin-left: 10px; color: #555;"/>
                                                    </li>
                                                </t>
                                            </ul>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <table class="table table-striped table-bordered" style="font-size: 15px; width: 96%; margin: 0 auto; box-shadow: 0 2px 5px rgba(0,0,0,0.1);">
                        <thead>
                            <tr style="background-color: #f2f2f2;">
                                <th class="text-center" style="vertical-align: middle;">Operación</th>
                                <th class="text-center" style="vertical-align: middle;">Fecha</th>
                                <th class="text-center" style="vertical-align: middle;">Cliente</th>
                                <th class="text-center" style="vertical-align: middle;">Modelos</th>
                                <th class="text-center" style="vertical-align: middle;">P. Unit ($)</th>
                                <th class="text-center" style="vertical-align: middle;">Total Bs</th>
                                <th class="text-center" style="vertical-align: middle;">Total $</th>
                                <th class="text-center" style="width: 25%; vertical-align: middle;">Pagos / Vueltos</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="docs" t-as="o">
                                <t t-set="tasa_actual" t-value="o.tasa_cambio if (o.usar_tasa_personalizada and o.tasa_cambio > 0) else o.tasa_bcv"/>
                                <t t-if="tasa_actual &lt;= 0">
                                    <t t-set="tasa_actual" t-value="1.0"/>
                                </t>

                                <td class="text-center" style="vertical-align: middle;"><strong><span t-field="o.referencia_pedido"/></strong></td>
                                <td class="text-center" style="vertical-align: middle;"><span t-field="o.fecha_creacion" t-options='{"widget": "date"}'/></td>
                                <td style="vertical-align: middle;"><span t-field="o.cliente_id"/></td>
                                
                                <td style="vertical-align: middle;">
                                    <t t-foreach="o.linea_ids" t-as="linea">
                                        <div>• <span t-esc="linea.producto_id.nombre"/> (x<span t-esc="int(linea.cantidad)"/>)</div>
                                    </t>
                                </td>
                                
                                <td class="text-end text-right" style="white-space:nowrap; vertical-align: middle;">
                                    <t t-foreach="o.linea_ids" t-as="linea">
                                        <t t-set="monto_usd" t-value="0"/>
                                        <t t-set="monto_bs" t-value="0"/>
                                        
                                        <t t-if="o.moneda == 'usd'">
                                            <t t-set="monto_usd" t-value="linea.precio_usd"/>
                                            <t t-set="monto_bs" t-value="linea.precio_usd * tasa_actual"/>
                                        </t>
                                        <t t-else="">
                                            <t t-set="monto_bs" t-value="linea.precio_bs"/>
                                            <t t-set="monto_usd" t-value="linea.precio_usd"/>
                                        </t>

                                        <div>
                                            $ <span t-esc="monto_usd" t-options='{"widget": "float", "precision": 2}'/>
                                            <div style="font-size: 12px; color: #555;">
                                                (Bs <span t-esc="monto_bs" t-options='{"widget": "float", "precision": 2}'/>)
                                            </div>
                                        </div>
                                    </t>
                                </td>

                                <td class="text-end text-right" style="vertical-align: middle;">
                                    <span t-field="o.total_global_bs" t-options='{"widget": "float", "precision": 2}'/>
                                    <div style="font-size: 12px; color: #555; margin-top: 2px;">
                                        <t t-if="o.usar_tasa_personalizada">(Tasa: <span t-esc="o.tasa_cambio"/>)</t>
                                        <t t-else="">(BCV: <span t-esc="o.tasa_bcv"/>)</t>
                                    </div>
                                </td>

                                <td class="text-end text-right" style="vertical-align: middle;">
                                    <span t-field="o.total_global_usd" t-options='{"widget": "float", "precision": 2}'/>
                                </td>
                                
                                <td style="font-size: 14px; vertical-align: middle; padding: 10px;">
                                    <t t-if="o.condiciones_pago == 'canon'">
                                        <div style="margin-bottom: 6px; color: #721c24; background-color: #f8d7da; padding: 5px; border-radius: 4px; border: 1px solid #f5c6cb;">
                                            <strong>🎁 CANON (REGALO/SIN COBRO)</strong>
                                            <div style="color: #444; font-size: 12px; margin-top: 4px;">
                                                <strong>Motivo:</strong> <span t-esc="o.nota_canon"/>
                                            </div>
                                        </div>
                                    </t>
                                    <t t-else="">
                                        <t t-foreach="o.pago_ids" t-as="p">
                                            <div style="margin-bottom: 6px; color: #155724; background-color: #f8fff8; padding: 5px; border-radius: 4px;">
                                                <strong>+ <span t-esc="p.tipo_pago.upper()"/>: <span t-esc="p.monto"/> <span t-esc="p.moneda.upper()"/></strong>
                                                
                                                <t t-if="p.tipo_pago == 'efectivo' and p.serial_billetes">
                                                    <div style="color: #444; font-size: 12px; margin-left: 10px;">
                                                        ↳ Seriales: <span t-esc="p.serial_billetes"/>
                                                    </div>
                                                </t>
                                                
                                                <t t-if="p.tipo_pago != 'efectivo' and p.referencia_banco">
                                                    <div style="color: #444; font-size: 12px; margin-left: 10px;">
                                                        ↳ Ref: <span t-esc="p.referencia_banco"/>
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                        
                                        <t t-if="o.vuelto_entregado_usd > 0">
                                            <div style="margin-top: 8px; border-top: 1px dashed #ccc; padding-top: 6px;">
                                                <strong class="text-danger">VUELTOS DADOS:</strong>
                                                <t t-foreach="o.billetes_vuelto_ids" t-as="b">
                                                    <div class="text-danger" style="margin-left: 10px; margin-bottom: 2px;">
                                                        - <span t-esc="b.cantidad"/>x $<span t-esc="b.denominacion"/> (S: <span t-esc="b.seriales"/>)
                                                    </div>
                                                </t>
                                            </div>
                                        </t>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>