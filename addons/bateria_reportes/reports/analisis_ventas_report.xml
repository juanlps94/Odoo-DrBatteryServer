<odoo>

    <record id="action_analisis_ventas_report" model="ir.actions.report">
        <field name="name">Reporte de Análisis de Ventas</field>
        <field name="model">bateria.analisis.ventas</field>
        <field name="report_type">qweb-pdf</field>

        <field name="report_name">bateria_reportes.analisis_ventas_template</field>
        <field name="report_file">bateria_reportes.analisis_ventas_template</field>

        <field name="print_report_name">
            'Reporte de Ventas - %s' % (object.fecha_entrega or '')
        </field>

        <field name="binding_model_id" ref="model_bateria_analisis_ventas"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
