<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_report_flota_pdf" model="ir.actions.report">
        <field name="name">Reporte de Gastos de Flota</field>
        <field name="model">bateria.vehiculo.servicio</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bateria_reportes.template_flota_servicio</field>
        <field name="report_file">bateria_reportes.template_flota_servicio</field>
        <field name="print_report_name">'Flota_Gastos'</field>
        <field name="binding_model_id" ref="model_bateria_vehiculo_servicio"/>
        <field name="binding_type">report</field>
    </record>

    <template id="template_flota_servicio">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-size: 16px;">
                    
                    <t t-set="total_gasolina" t-value="sum([o.costo_total for o in docs if o.tipo_servicio == 'gasolina'])"/>
                    <t t-set="total_litros" t-value="sum([o.cantidad_litros for o in docs if o.tipo_servicio == 'gasolina'])"/>
                    <t t-set="total_mantenimiento" t-value="sum([o.costo_total for o in docs if o.tipo_servicio == 'mantenimiento'])"/>

                    <div class="text-center mt-4 mb-4">
                        <h2 style="font-weight: bold;">Reporte de Servicios de Flota</h2>
                        <p class="text-muted">Desglose de gastos de combustible y taller</p>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <table class="table table-bordered">
                                <thead style="background-color: #f8f9fa;">
                                    <tr><th colspan="2" class="text-center">Resumen de Inversión ($)</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Total Combustible:</td>
                                        <td class="text-right"><strong>$ <span t-esc="total_gasolina" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                                    </tr>
                                    <tr>
                                        <td>Total Litros Echados:</td>
                                        <td class="text-right"><strong><span t-esc="total_litros" t-options='{"widget": "float", "precision": 2}'/> Lts</strong></td>
                                    </tr>
                                    <tr>
                                        <td>Total Mantenimiento:</td>
                                        <td class="text-right"><strong>$ <span t-esc="total_mantenimiento" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                                    </tr>
                                    <tr style="background-color: #e9ecef;">
                                        <td><strong>TOTAL GASTOS:</strong></td>
                                        <td class="text-right"><strong>$ <span t-esc="total_gasolina + total_mantenimiento" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <table class="table table-striped table-sm">
                        <thead style="background-color: #17a2b8; color: white;">
                            <tr>
                                <th>Fecha</th>
                                <th>Vehículo (Placa)</th>
                                <th>Tipo de Gasto</th>
                                <th class="text-center">Km Actual</th>
                                <th class="text-center">Recorrido</th>
                                <th class="text-center">Litros</th>
                                <th class="text-right">Costo ($)</th>
                                <th>Notas</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="doc">
                                <tr>
                                    <td><span t-field="doc.fecha" t-options='{"widget": "date"}'/></td>
                                    <td><strong><span t-field="doc.vehiculo_id.name"/></strong></td>
                                    <td>
                                        <span t-if="doc.tipo_servicio == 'gasolina'" class="badge badge-info" style="color: blue;">Gasolina</span>
                                        <span t-else="" class="badge badge-warning" style="color: orange;">Mantenimiento</span>
                                    </td>
                                    <td class="text-center"><span t-field="doc.km_actual"/></td>
                                    <td class="text-center"><span t-field="doc.km_recorridos"/></td>
                                    <td class="text-center">
                                        <span t-if="doc.tipo_servicio == 'gasolina'"><span t-field="doc.cantidad_litros"/></span>
                                        <span t-else="">-</span>
                                    </td>
                                    <td class="text-right" style="font-weight: bold;">
                                        $ <span t-esc="doc.costo_total" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                    <td><span t-field="doc.notas"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>