<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cuenta_activo" model="bateria.cuenta.contable">
            <field name="codigo">1</field>
            <field name="name">ACTIVO</field>
            <field name="tipo">1</field>
        </record>
        
        <record id="cuenta_circulante" model="bateria.cuenta.contable">
            <field name="codigo">1.1</field>
            <field name="name">ACTIVO CIRCULANTE</field>
            <field name="tipo">1</field>
            <field name="padre_id" ref="cuenta_activo"/>
        </record>

        <record id="cuenta_efectivo_bancos" model="bateria.cuenta.contable">
            <field name="codigo">1.1.01</field>
            <field name="name">EFECTIVO EN CAJA Y BANCOS</field>
            <field name="tipo">1</field>
            <field name="padre_id" ref="cuenta_circulante"/>
        </record>

        <record id="cuenta_banesco" model="bateria.cuenta.contable">
            <field name="codigo">1.1.01.01</field>
            <field name="name">Banco Banesco Cta Corriente</field>
            <field name="tipo">1</field>
            <field name="padre_id" ref="cuenta_efectivo_bancos"/>
        </record>

        <record id="cuenta_efectivo_galpon" model="bateria.cuenta.contable">
            <field name="codigo">1.1.01.02</field>
            <field name="name">Caja Principal Efectivo Galpón</field>
            <field name="tipo">1</field>
            <field name="padre_id" ref="cuenta_efectivo_bancos"/>
        </record>

        <record id="caja_banesco" model="bateria.caja">
            <field name="name">Banesco</field>
            <field name="tipo">banco</field>
            <field name="moneda">bs</field>
            <field name="cuenta_contable_id" ref="cuenta_banesco"/>
        </record>

        <record id="caja_efectivo_galpon" model="bateria.caja">
            <field name="name">Efectivo Galpón</field>
            <field name="tipo">efectivo</field>
            <field name="moneda">usd</field>
            <field name="cuenta_contable_id" ref="cuenta_efectivo_galpon"/>
        </record>
    </data>
</odoo>