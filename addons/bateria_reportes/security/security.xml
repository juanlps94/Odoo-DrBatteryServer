<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_bateria">
            <field name="name">Sistema ERP (Don Juan)</field>
            <field name="description">Roles de acceso al sistema empresarial</field>
            <field name="sequence">10</field>
        </record>

        <record id="privilege_bateria_roles" model="res.groups.privilege">
            <field name="name">Niveles de Acceso</field>
            <field name="category_id" ref="module_category_bateria"/>
        </record>

        <record id="group_bateria_venta" model="res.groups">
            <field name="name">Ventas y Flota</field>
            <field name="privilege_id" ref="privilege_bateria_roles"/>
            <field name="comment">Acceso a facturación, clientes, vehículos y servicios.</field>
        </record>

        <record id="group_bateria_compra" model="res.groups">
            <field name="name">Compras</field>
            <field name="privilege_id" ref="privilege_bateria_roles"/>
            <field name="comment">Acceso a proveedores, presupuestos y órdenes de compra.</field>
        </record>

        <record id="group_bateria_contabilidad" model="res.groups">
            <field name="name">Contabilidad</field>
            <field name="privilege_id" ref="privilege_bateria_roles"/>
            <field name="comment">Acceso a cuentas por pagar, pagos, cajas y reportes financieros.</field>
        </record>

        <record id="group_bateria_admin" model="res.groups">
            <field name="name">Administrador y Desarrollador</field>
            <field name="privilege_id" ref="privilege_bateria_roles"/>
            <field name="implied_ids" eval="[(4, ref('group_bateria_venta')), (4, ref('group_bateria_compra')), (4, ref('group_bateria_contabilidad'))]"/>
            <field name="comment">Acceso total al sistema, inventario, traslados y configuración.</field>
        </record>
    </data>
</odoo>