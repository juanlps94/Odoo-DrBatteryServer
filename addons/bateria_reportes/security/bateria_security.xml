<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.module.category" id="module_category_bateria">
            <field name="name">Gestión de Baterías</field>
            <field name="sequence">10</field>
        </record>

        <record id="group_bateria_ventas" model="res.groups">
            <field name="name">Baterías: Vendedor</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_bateria_inventario" model="res.groups">
            <field name="name">Baterías: Inventario y Taller</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_bateria_compras" model="res.groups">
            <field name="name">Baterías: Jefe de Compras</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_bateria_manager" model="res.groups">
            <field name="name">Baterías: Gerente / Administrador</field>
            <field name="implied_ids" eval="[(4, ref('group_bateria_ventas')), (4, ref('group_bateria_inventario')), (4, ref('group_bateria_compras'))]"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="rule_bateria_gasto_company" model="ir.rule">
            <field name="name">Gastos por Compañía</field>
            <field name="model_id" ref="model_bateria_gasto_operativo"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_bateria_cuenta_company" model="ir.rule">
            <field name="name">Cuentas Contables por Compañía</field>
            <field name="model_id" ref="model_bateria_cuenta_contable"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_bateria_caja_company" model="ir.rule">
            <field name="name">Cajas y Bancos por Compañía</field>
            <field name="model_id" ref="model_bateria_caja"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_bateria_diario_company" model="ir.rule">
            <field name="name">Diarios por Compañía</field>
            <field name="model_id" ref="model_bateria_diario"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_bateria_asiento_company" model="ir.rule">
            <field name="name">Asientos por Compañía</field>
            <field name="model_id" ref="model_bateria_asiento"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_bateria_libro_mayor_company" model="ir.rule">
            <field name="name">Libro Mayor por Compañía</field>
            <field name="model_id" ref="model_bateria_libro_mayor"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_bateria_orden_venta_company" model="ir.rule">
            <field name="name">Ventas por Compañía</field>
            <field name="model_id" ref="model_bateria_orden_venta"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>