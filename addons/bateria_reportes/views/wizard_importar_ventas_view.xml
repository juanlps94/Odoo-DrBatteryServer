<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bateria_importar_ventas_form" model="ir.ui.view">
        <field name="name">bateria.importar.ventas.form</field>
        <field name="model">bateria.importar.ventas.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Ventas Históricas (CSV)">
                <sheet>
                    <div class="alert alert-info">
                        Sube el archivo CSV con las ventas. El sistema identificará automáticamente los modelos, creará los seriales y fijará la fecha de inicio de garantía exacta.
                    </div>
                    <group>
                        <field name="cliente_id" options="{'no_create': True}"/>
                        <field name="fecha_venta"/>
                        <field name="archivo_csv" filename="nombre_archivo"/>
                        <field name="nombre_archivo" invisible="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_importar" string="Importar y Generar Factura Atrasada" type="object" class="btn-primary" icon="fa-magic"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bateria_importar_ventas" model="ir.actions.act_window">
        <field name="name">Importador de Ventas Históricas</field>
        <field name="res_model">bateria.importar.ventas.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bateria_importar_ventas"
              name="Importar Ventas de CSV"
              parent="menu_bateria_ventas_root"
              action="action_bateria_importar_ventas"
              sequence="99"
              groups="base.group_erp_manager"/>
</odoo>