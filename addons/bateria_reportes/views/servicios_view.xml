<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bateria_servicio_tree" model="ir.ui.view">
        <field name="name">bateria.pago.servicio.tree</field>
        <field name="model">bateria.pago.servicio</field>
        <field name="arch" type="xml">
            <list decoration-success="estado == 'pagado'" decoration-warning="estado == 'confirmado'" decoration-info="estado == 'borrador'">
                <header>
                    <button name="%(bateria_reportes.action_bateria_servicio_diario_wizard)d" type="action" string="🖨️ Reporte por Fechas" class="btn-primary" display="always"/>
                </header>
                <field name="fecha"/>
                <field name="servicio_id"/>
                <field name="name" string="Mes / Detalle"/>
                <field name="empresa_paga"/>
                <field name="monto_total" widget="monetary" options="{'currency_field': 'moneda'}"/>
                <field name="saldo_pendiente" widget="monetary" options="{'currency_field': 'moneda'}" decoration-danger="saldo_pendiente &gt; 0"/>
                <field name="moneda" column_invisible="True"/>
                <field name="estado" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_bateria_servicio_form" model="ir.ui.view">
        <field name="name">bateria.pago.servicio.form</field>
        <field name="model">bateria.pago.servicio</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirmar_servicio" string="✅ Confirmar Servicio" type="object" class="oe_highlight btn-success" invisible="estado != 'borrador'"/>
                    <button name="%(bateria_reportes.action_reporte_diario_servicios)d" string="🖨️ Imprimir Comprobante" type="action" class="btn-info" invisible="estado == 'borrador'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,confirmado,pagado"/>
                </header>
                <sheet>
                <group>
                        <field name="tipo_documento" widget="radio" options="{'horizontal': true}" readonly="estado != 'borrador'"/>
                    </group>
                    <div class="oe_title">
                        <label for="servicio_id" string="Servicio (Ej. Corpoelec, CANTV)"/>
                        <h1><field name="servicio_id" readonly="estado != 'borrador'"/></h1>
                    </div>
                    <group>
                        <group string="Detalles">
                            <field name="name" readonly="estado != 'borrador'"/>
                            <field name="fecha" readonly="estado != 'borrador'"/>
<field name="cuenta_id" options="{'no_create': True}" placeholder="Clasificación contable del gasto..." invisible="tipo_documento == 'nota_entrega'" required="tipo_documento == 'factura'"/>                            <field name="empresa_paga" readonly="estado != 'borrador'"/>
                            <field name="cuenta" readonly="estado != 'borrador'"/>
                        </group>
                        <group string="Valor (Monto Base)">
                            <field name="moneda" widget="radio" options="{'horizontal': true}" readonly="estado != 'borrador'"/>
                            <field name="monto_base" readonly="estado != 'borrador'" style="font-size: 18px; font-weight: bold;" widget="monetary" options="{'currency_field': 'moneda'}"/>
                            <field name="asiento_id" invisible="not asiento_id" decoration-bf="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Registro de Pagos / Abonos">
                            <div class="alert alert-info" role="alert" invisible="estado != 'borrador'">
                                ℹ️ Primero debes hacer clic en el botón verde <b>"Confirmar Servicio"</b> de arriba para poder registrar los pagos.
                            </div>
                            <field name="pago_ids" readonly="estado == 'borrador'">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="caja_id" placeholder="Banco o Caja..."/>
                                    <field name="metodo_pago"/>
                                    <field name="referencia" placeholder="Nro Transferencia"/>
                                    <field name="moneda"/>
                                    <field name="monto" sum="Total Abonado"/>
                                </list>
                            </field>
                            
                            <group class="oe_subtotal_footer oe_right">
                                <field name="aplica_iva" invisible="1"/>
                                
                                <div colspan="2" class="text-end">
                                    <button name="action_agregar_iva" type="object" string="➕ Añadir IVA (16%)" class="btn btn-sm btn-info mb-2" invisible="aplica_iva or estado != 'borrador'"/>
                                    <button name="action_quitar_iva" type="object" string="❌ Quitar IVA" class="btn btn-sm btn-danger mb-2" invisible="not aplica_iva or estado != 'borrador'"/>
                                </div>
                                
                                <field name="monto_base" string="Subtotal" widget="monetary" options="{'currency_field': 'moneda'}"/>
                                <field name="monto_iva" string="IVA (16%)" widget="monetary" options="{'currency_field': 'moneda'}" invisible="not aplica_iva"/>
                                <field name="monto_total" string="Total con IVA" class="fw-bold text-success" widget="monetary" options="{'currency_field': 'moneda'}"/>
                                
                                <hr colspan="2" style="border-top: 1px solid #ccc; margin: 10px 0;"/>
                                
                                <field name="monto_pagado" string="Monto Abonado" widget="monetary" options="{'currency_field': 'moneda'}"/>

                                <field name="saldo_pendiente" string="Deuda Restante" class="fw-bold text-danger" widget="monetary" options="{'currency_field': 'moneda'}"/>
                                <field name="tipo_documento" widget="badge" decoration-info="tipo_documento == 'nota_entrega'" decoration-success="tipo_documento == 'factura'"/>
                            </group>
                            
                            <group string="Configuración de Moneda y Tasa">
                                <group>
                                    <field name="moneda_referencia" widget="radio" options="{'horizontal': true}"/>
                                    <button name="action_actualizar_tasa_bcv_manual" type="object" string="Actualizar Tasa" icon="fa-refresh" class="btn btn-sm btn-info"/>
                                </group>
                                <group>
                                    <field name="tasa_aplicada" string="Tasa Activa" readonly="1" force_save="1" decoration-bf="1" decoration-success="1"/>
                                    <field name="usar_tasa_personalizada" widget="boolean_toggle"/>
                                    <field name="tasa_cambio" invisible="not usar_tasa_personalizada" required="usar_tasa_personalizada"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bateria_servicio" model="ir.actions.act_window">
        <field name="name">Pago de Servicios</field>
        <field name="res_model">bateria.pago.servicio</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bateria_servicios_root" 
              name="Servicios" 
              parent="bateria_reportes.menu_bateria_root" 
              action="action_bateria_servicio" 
              sequence="55"/>
</odoo>