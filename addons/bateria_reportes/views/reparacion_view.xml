<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="action_report_orden_reparacion" model="ir.actions.report">
        <field name="name">Imprimir Orden de Reparación</field>
        <field name="model">bateria.reparacion</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bateria_reportes.reporte_orden_reparacion_template</field>
        <field name="report_file">bateria_reportes.reporte_orden_reparacion_template</field>
        <field name="binding_model_id" ref="model_bateria_reparacion"/>
        <field name="binding_type">report</field>
    </record>

    <template id="reporte_orden_reparacion_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <div class="page" style="font-size: 14px; color: #000; padding-top: 20px;">
                        
                        <div class="row mb-4 align-items-center">
                            <div class="col-4">
                                <img src="/bateria_reportes/static/src/img/logo_jjs.png" style="max-height: 80px;" alt="Logo JJS"/>
                            </div>
                            <div class="col-8 text-end">
                                <h2 style="font-weight: bold; border-bottom: 2px solid #000; padding-bottom: 10px; display: inline-block;">ORDEN DE REPARACIÓN / REVISIÓN</h2>
                                <h4 style="color: #333;">N° <span t-field="doc.name"/></h4>
                            </div>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Cliente:</strong> <span t-field="doc.cliente_id.name"/><br/>
                                <t t-if="doc.cliente_id.rif"><strong>C.I / R.I.F:</strong> <span t-field="doc.cliente_id.rif"/><br/></t>
                                <strong>Fecha de Ingreso:</strong> <span t-field="doc.create_date" t-options='{"widget": "date"}'/><br/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Tipo de Servicio:</strong> <span t-field="doc.tipo_reparacion"/><br/>
                                <strong>Técnico Asignado:</strong> <span t-field="doc.responsable_id.name"/><br/>
                                <strong>Estado Actual:</strong> <span class="text-uppercase fw-bold" t-field="doc.estado"/><br/>
                            </div>
                        </div>

                        <h5 style="border-bottom: 2px solid #555; padding-bottom: 3px; font-weight: bold;">Datos de la Batería</h5>
                        <table class="table table-bordered table-sm mb-4">
                            <tr>
                                <td style="width: 33%;"><strong>Modelo:</strong> <span t-field="doc.producto_id.nombre"/></td>
                                <td style="width: 33%;">
                                    <strong>Serial:</strong> 
                                    <t t-if="doc.es_sistema_anterior"><span t-field="doc.serial_manual"/></t>
                                    <t t-else=""><span t-field="doc.serial_id.nombre"/></t>
                                </td>
                                <td style="width: 34%;"><strong>Tiempo de Uso:</strong> <span t-field="doc.tiempo_uso"/></td>
                            </tr>
                            <tr>
                                <td colspan="3"><strong>Falla / Detalle Reportado:</strong> <span t-field="doc.descripcion"/></td>
                            </tr>
                        </table>

                        <t t-if="doc.producto_prestamo_id">
                            <div style="background-color: #fff3cd; padding: 10px; border-radius: 5px; border: 1px solid #ffe69c; margin-bottom: 20px;">
                                <h6 style="font-weight: bold; margin-bottom: 5px;"><i class="fa fa-battery-half"/> Batería de Préstamo Entregada al Cliente</h6>
                                <p style="margin-bottom: 0;"><strong>Modelo:</strong> <span t-field="doc.producto_prestamo_id.nombre"/> | <strong>Serial Físico:</strong> <span t-field="doc.serial_prestamo"/></p>
                            </div>
                        </t>

                        <h5 style="border-bottom: 2px solid #555; padding-bottom: 3px; font-weight: bold;">Cargos y Servicios Técnicos</h5>
                        <t t-if="not doc.pieza_ids">
                            <p class="text-muted"><em>No se han registrado cobros ni repuestos para esta orden.</em></p>
                        </t>
                        <t t-if="doc.pieza_ids">
                            <table class="table table-bordered table-sm mt-2">
                                <thead style="background-color: #f0f0f0; color: #000;">
                                    <tr>
                                        <th class="text-center">CANT.</th>
                                        <th>DESCRIPCIÓN</th>
                                        <th class="text-end">PRECIO UNIT. ($)</th>
                                        <th class="text-end">SUBTOTAL ($)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.pieza_ids" t-as="pieza">
                                        <td class="text-center"><span t-field="pieza.cantidad"/></td>
                                        <td><span t-field="pieza.descripcion"/></td>
                                        <td class="text-end">$ <span t-field="pieza.precio_unitario" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td class="text-end">$ <span t-field="pieza.subtotal" t-options='{"widget": "float", "precision": 2}'/></td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="row justify-content-end mt-3">
                                <div class="col-5">
                                    <table class="table table-sm table-borderless">
                                        <tr class="border-top" style="font-size: 18px; border-color: #000;">
                                            <td><strong>TOTAL A COBRAR:</strong></td>
                                            <td class="text-end fw-bold text-success"><strong>$ <span t-field="doc.total_reparacion" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </t>
                        
                        <t t-if="doc.notas_reparacion or doc.notas_presupuesto">
                            <div class="mt-4" style="font-size: 12px;">
                                <strong>Observaciones Adicionales:</strong><br/>
                                <span t-field="doc.notas_reparacion"/><br/>
                                <span t-field="doc.notas_presupuesto"/>
                            </div>
                        </t>

                        <div class="row mt-5 pt-5 text-center">
                            <div class="col-6">
                                <hr style="border-top: 1px solid black; width: 80%;"/>
                                <strong>Firma del Cliente</strong><br/>
                                <span style="font-size: 10px;">Acepto las condiciones de ingreso</span>
                            </div>
                            <div class="col-6">
                                <hr style="border-top: 1px solid black; width: 80%;"/>
                                <strong>Firma del Técnico</strong>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="view_bateria_reparacion_list" model="ir.ui.view">
        <field name="name">bateria.reparacion.list</field>
        <field name="model">bateria.reparacion</field>
        <field name="arch" type="xml">
            <list decoration-info="estado == 'presupuesto'" decoration-success="estado == 'reparado'">
                <field name="name" string="Referencia"/>
                <field name="fecha_programada"/>
                <field name="serial_id" string="Serial (Odoo)" optional="show"/>
                <field name="serial_manual" string="Serial (Físico)" optional="show"/>
                <field name="cliente_id"/>
                <field name="producto_id" optional="show"/>
                <field name="tipo_reparacion"/>
                <field name="tiempo_uso" string="Tiempo de Uso" decoration-danger="1"/>
                <field name="total_reparacion" string="Cobro ($)" sum="Total" decoration-bf="1"/>
                <field name="estado" widget="badge" 
                       decoration-info="estado == 'presupuesto'" 
                       decoration-warning="estado == 'confirmado'" 
                       decoration-success="estado == 'reparado'"/>
            </list>
        </field>
    </record>

    <record id="view_bateria_reparacion_form" model="ir.ui.view">
        <field name="name">bateria.reparacion.form</field>
        <field name="model">bateria.reparacion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirmar" string="Confirmar Reparación" type="object" class="oe_highlight" invisible="estado != 'presupuesto'"/>
                    <button name="action_reparar" string="Marcar como Reparado" type="object" class="oe_highlight" invisible="estado != 'confirmado'"/>
                    <button name="action_convertir_reposicion" string="🔄 Convertir a Reposición" type="object" class="btn-danger" invisible="estado == 'reparado' or tipo_reparacion == 'reposicion'"/>
                    <button name="action_cancelar" string="Cancelar" type="object" invisible="estado in ('reparado', 'cancelado')"/>

                    <button name="%(action_report_orden_reparacion)d" string="🖨️ Imprimir Orden" type="action" class="btn-secondary"/>

                    <button name="action_procesar_destino_bateria" string="♻️ Procesar Batería Dañada" type="object" class="btn-warning" invisible="destino_bateria == 'cliente' or bateria_procesada == True"/>
                    <field name="estado" widget="statusbar" statusbar_visible="presupuesto,confirmado,reparado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Referencia"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Información del Trabajo">
                            <field name="tipo_reparacion"/>
                            <field name="descripcion"/>
                            <field name="fecha_programada"/>
                            <field name="responsable_id"/>
                        </group>
                        <group string="Datos de la Batería a Reparar" style="background-color: #f8f9fa; border-radius: 5px; padding: 10px;">
                            <field name="es_sistema_anterior" widget="boolean_toggle" decoration-danger="1"/>
                            
                            <field name="serial_id" placeholder="Escanear serial de Odoo..." options="{'no_create': True}" invisible="es_sistema_anterior" required="not es_sistema_anterior"/>
                            
                            <field name="serial_manual" placeholder="Escribir serial físico de la etiqueta..." invisible="not es_sistema_anterior" required="es_sistema_anterior"/>
                            
                            <field name="producto_id" force_save="1"/>
                            <field name="cantidad"/>
                            
                            <hr colspan="2"/>
                            <field name="fecha_compra_bateria" />
                            <field name="tiempo_uso" readonly="1" force_save="1" decoration-danger="1" decoration-bf="1"/>
                            <field name="serial_entregado_id" 
                                   invisible="tipo_reparacion != 'reposicion'" 
                                   required="tipo_reparacion == 'reposicion'" 
                                   options="{'no_create': True}" 
                                   placeholder="Escanea el serial de la batería NUEVA..."
                                   style="font-size: 16px; font-weight: bold; color: #28a745;"/>
                        </group>
                        <group string="Información del Cliente">
                            <field name="cliente_id" force_save="1" required="1"/>
                            <field name="venta_id" force_save="1" string="Factura Original" invisible="es_sistema_anterior"/>
                            <field name="devolver"/>
                        </group>
                        <group string="🚨 ¿La batería NO tiene arreglo?" style="background-color: #fff3cd; border-radius: 5px; padding: 10px; margin-top: 15px;">
    <field name="destino_bateria" widget="radio" options="{'horizontal': true}" readonly="bateria_procesada == True"/>
    <field name="bateria_procesada" invisible="1"/>
    <div class="alert alert-success w-100 mt-2 mb-0" role="alert" invisible="not bateria_procesada">
        ✅ Esta batería ya fue procesada e ingresada al almacén de Chatarras.
    </div>
</group>
                    </group>
                    <notebook>
                        <page string="1. Batería de Préstamo (Opcional)">
                            <div class="alert alert-info" role="alert">
                                ℹ️ Registra aquí la batería que le estás entregando temporalmente al cliente. Esta sección es informativa y no suma al cobro del presupuesto.
                            </div>
                            <group>
                                <group>
                                    <field name="producto_prestamo_id" options="{'no_create': True}"/>
                                    <field name="serial_prestamo" placeholder="Ej: AB12345..."/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="2. Cobranza (Servicios y Repuestos)">
                            <field name="pieza_ids">
                                <list editable="bottom">
                                    <field name="tipo"/>
                                    <field name="producto_id" optional="show"/>
                                    <field name="descripcion" placeholder="Ej: Carga Lenta, Relleno de Ácido..."/>
                                    <field name="cantidad"/>
                                    <field name="precio_unitario"/>
                                    <field name="subtotal" sum="Total Servicios"/>
                                </list>
                            </field>
                            
                            <group class="oe_subtotal_footer oe_right mt-3">
                                <field name="total_reparacion" string="TOTAL A COBRAR" class="fw-bold text-success" style="font-size: 18px;" widget="monetary" options="{'currency_symbol': '$'}"/>
                            </group>
                        </page>
                        
                        <page string="3. Notas Adicionales">
                            <group>
                                <field name="notas_reparacion" placeholder="Observaciones sobre el estado de la batería..."/>
                                <field name="notas_presupuesto" placeholder="Notas sobre el cobro..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bateria_reparacion" model="ir.actions.act_window">
        <field name="name">Órdenes de Reparación</field>
        <field name="res_model">bateria.reparacion</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_reparacion_root" name="Reparaciones" sequence="30"/>
    <menuitem id="menu_ordenes_reparacion" name="Órdenes de reparación" parent="menu_reparacion_root" action="action_bateria_reparacion"/>
</odoo>