<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_tabla_dinamica_ventas_list" model="ir.ui.view">
        <field name="name">bateria.tabla.dinamica.ventas.list</field>
        <field name="model">bateria.tabla.dinamica.ventas</field>
        <field name="arch" type="xml">
            <list>
                <field name="mes"/>
                <field name="total_ventas"/>
                <field name="total_punto_venta"/>
                <field name="total_imponible"/>
            </list>
        </field>
    </record>

    <record id="view_tabla_dinamica_ventas_form" model="ir.ui.view">
        <field name="name">bateria.tabla.dinamica.ventas.form</field>
        <field name="model">bateria.tabla.dinamica.ventas</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="mes"/>
                        <field name="total_ventas"/>
                        <field name="total_punto_venta"/>
                        <field name="total_imponible"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_tabla_dinamica_ventas" model="ir.actions.act_window">
        <field name="name">Tabla Dinámica Análisis de Ventas</field>
        <field name="res_model">bateria.tabla.dinamica.ventas</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
