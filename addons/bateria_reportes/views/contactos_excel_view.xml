<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- LIST -->
    <record id="view_contactos_excel_list" model="ir.ui.view">
        <field name="name">bateria.contactos.excel.list</field>
        <field name="model">bateria.contactos.excel</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="moneda_visualizacion"/>
                <field name="total_adeudado"/>
                <field name="email"/>
                <field name="movil"/>
                <field name="ciudad"/>
                <field name="pais"/>
            </list>
        </field>
    </record>

    <!-- FORM -->
    <record id="view_contactos_excel_form" model="ir.ui.view">
        <field name="name">bateria.contactos.excel.form</field>
        <field name="model">bateria.contactos.excel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="nombre"/>
                        <field name="moneda_visualizacion"/>
                        <field name="total_adeudado"/>
                    </group>
                    <group>
                        <field name="email"/>
                        <field name="movil"/>
                        <field name="telefono"/>
                    </group>
                    <group>
                        <field name="comercial"/>
                        <field name="actividades"/>
                    </group>
                    <group>
                        <field name="ciudad"/>
                        <field name="pais"/>
                        <field name="idioma"/>
                        <field name="compania"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_contactos_excel" model="ir.actions.act_window">
        <field name="name">Contactos (Excel)</field>
        <field name="res_model">bateria.contactos.excel</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
