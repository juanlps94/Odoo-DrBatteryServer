<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bateria_compra_form" model="ir.ui.view">
        <field name="name">bateria.compra.form</field>
        <field name="model">bateria.compra</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirmar_pedido" string="Confirmar Compra" type="object" class="oe_highlight" invisible="estado != 'borrador'"/>
                    <button name="action_recibir_mercancia" string="Marcar como Recibido" type="object" class="oe_highlight" invisible="estado != 'confirmado'"/>
                    <button name="action_crear_factura" string="Crear Factura / CxP" type="object" class="oe_highlight" invisible="estado != 'recibido'"/>
                    <button name="action_cancelar" string="Cancelar" type="object" invisible="estado in ('facturado', 'pagado', 'cancelado')"/>
                    
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,confirmado,recibido,facturado,pagado"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_recibir_mercancia" type="object" class="oe_stat_button" icon="fa-truck" invisible="not albaran_entrada_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Ver Albarán</span>
                            </div>
                        </button>
                    </div>
                    <field name="albaran_entrada_id" invisible="1"/>

                    <group>
                        <field name="tipo_documento" widget="radio" options="{'horizontal': true}" readonly="estado != 'borrador'"/>
                    </group>

                    <div class="oe_title">
                        <label for="name" string="Referencia de Operación"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    
                    <group>
                        <group string="Datos del Proveedor / Tienda">
                            <field name="proveedor_id" placeholder="Supermercado, Proveedor de Baterías, etc."/>
                            <field name="rif"/>
                        </group>
                        
                        <group string="Clasificación Contable">
                            <field name="fecha"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/> <field name="centro_costo_id" placeholder="Crear o buscar centro de gastos..."/>                            <field name="centro_costo_id" placeholder="Crear o buscar centro de gastos..."/>
                            <field name="ubicacion_id" placeholder="Almacén, Sede o Sucursal destino..."/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Detalle del Gasto / Artículos">
                            <field name="linea_ids" readonly="estado in ('recibido', 'facturado', 'pagado', 'cancelado')">
                                <list editable="bottom">
                                    <field name="moneda" column_invisible="True"/>
                                    
                                    <field name="imagen_producto" widget="image" options="{'size': [40, 40]}" optional="show"/>
                                    <field name="producto_maestro_id" placeholder="Buscar Batería..." options="{'no_create': True}"/>
                                    <field name="gasto_id" placeholder="Escribir Insumo o Gasto..." options="{'no_create_edit': True}"/>
                                    <field name="descripcion_proveedor" string="Modelo / Detalle" placeholder="Ej: Tomate Perita, Cebolla..."/>
                                    <field name="info_competencia" readonly="1" decoration-info="1" optional="show" string="Análisis de Precio" widget="text"/>
                                    
                                    <field name="es_para_flota" widget="boolean_toggle" string="🚗 Flota"/>
                                    <field name="vehiculo_id" placeholder="Placa..." invisible="not es_para_flota" required="es_para_flota" options="{'no_create': True}"/>
                                    
                                    <field name="cantidad" string="Cant. / Peso"/>
                                    <field name="unidad_medida" string="U.M."/>
                                    
                                    <field name="precio_usd" widget="monetary" options="{'currency_symbol': '$'}"/>
                                    <field name="precio_bs" widget="monetary" options="{'currency_symbol': 'Bs'}"/>
                                    
                                    <field name="descuento_porcentaje" string="Desc. (%)" decoration-danger="descuento_porcentaje &gt; 0"/>
                                    
                                    <field name="subtotal_usd" readonly="1" force_save="1" widget="monetary" options="{'currency_symbol': '$'}"/>
                                    <field name="subtotal_bs" readonly="1" force_save="1" widget="monetary" options="{'currency_symbol': 'Bs'}"/>
                                    
                                    <field name="aplica_iva" widget="boolean_toggle" string="IVA"/>
                                </list>
                            </field>
                            
                            <group>
                                <group string="Aplicar Retenciones">
                                    <label for="porcentaje_retencion_iva" string="Retención de IVA" invisible="monto_iva == 0"/>
                                    <div class="o_row" invisible="monto_iva == 0">
                                        <field name="porcentaje_retencion_iva" widget="radio" options="{'horizontal': true}"/>
                                    </div>
                                    <field name="comprobante_retencion_iva" placeholder="Nro de Comprobante..." invisible="porcentaje_retencion_iva == '0'" required="porcentaje_retencion_iva != '0'"/>
                                    
                                    <field name="porcentaje_retencion_islr" string="% Retención ISLR" placeholder="Ej: 2"/>
                                    <field name="comprobante_retencion_islr" placeholder="Nro de Comprobante..." invisible="porcentaje_retencion_islr == 0.0" required="porcentaje_retencion_islr != 0.0"/>
                                </group>
                                
                                <group class="oe_subtotal_footer oe_right">
                                    <div colspan="2" class="text-end">
                                        <button name="action_agregar_iva" type="object" string="➕ Todo con IVA" class="btn btn-sm btn-info mb-2" invisible="estado in ('pagado', 'cancelado')"/>
                                        <button name="action_quitar_iva" type="object" string="❌ Todo Exento" class="btn btn-sm btn-danger mb-2" invisible="estado in ('pagado', 'cancelado')"/>
                                    </div>
                                    
                                    <field name="descuento_global" string="Descuento Factura Extra" widget="monetary" options="{'currency_field': 'moneda'}" decoration-danger="1"/>
                                    
                                    <field name="base_exenta" string="Base Exenta (E)" widget="monetary" options="{'currency_field': 'moneda'}" invisible="base_exenta == 0"/>
                                    <field name="base_imponible" string="Base Imponible (I)" widget="monetary" options="{'currency_field': 'moneda'}" invisible="base_imponible == 0"/>
                                    <field name="monto_base_compra" string="Total Base" widget="monetary" options="{'currency_field': 'moneda'}"/>
                                    <field name="monto_iva" string="IVA (16%)" widget="monetary" options="{'currency_field': 'moneda'}" invisible="monto_iva == 0"/>
                                    
                                    <field name="total" string="Total Bruto" widget="monetary" options="{'currency_field': 'moneda'}"/>
                                    
                                    <field name="monto_retencion_iva" string="- Ret. IVA" widget="monetary" options="{'currency_field': 'moneda'}" decoration-danger="1" invisible="monto_retencion_iva == 0"/>
                                    <field name="monto_retencion_islr" string="- Ret. ISLR" widget="monetary" options="{'currency_field': 'moneda'}" decoration-danger="1" invisible="monto_retencion_islr == 0"/>
                                    
                                    <hr colspan="2" style="border-top: 1px solid #ccc; margin: 10px 0;"/>
                                    
                                    <field name="total_neto" string="TOTAL NETO A PAGAR" class="fw-bold text-success" widget="monetary" options="{'currency_field': 'moneda'}"/>
                                    
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label"><label for="total_global_usd" string="Neto Global ($)"/></div>
                                    <field name="total_global_usd" nolabel="1" class="oe_subtotal_footer_separator text-success" widget="monetary" options="{'currency_symbol': '$'}"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label"><label for="total_global_bs" string="Neto Global (Bs)"/></div>
                                    <field name="total_global_bs" nolabel="1" class="oe_subtotal_footer_separator text-primary" widget="monetary" options="{'currency_symbol': 'Bs'}"/>
                                </group>
                            </group>
                        </page>

                        <page string="Registro de Pagos">
                            <group>
                                <group>
                                    <field name="condicion_pago" widget="selection"/>
                                </group>
                                <group>
                                    <field name="cuenta_pagar_id" invisible="not cuenta_pagar_id"/>
                                </group>
                            </group>
                            
                            <separator string="Historial de Pagos / Abonos"/>
                            <field name="pago_ids" readonly="estado == 'cancelado'">
                                <list editable="bottom">
                                    <field name="fecha"/>
                                    <field name="caja_id" placeholder="Banco o Caja..."/>
                                    <field name="metodo_pago"/>
                                    <field name="referencia" placeholder="Nro Transferencia"/>
                                    <field name="moneda"/>
                                    <field name="monto" sum="Total Abonado"/>
                                </list>
                            </field>
                            
                            <group class="oe_subtotal_footer oe_right">
                                <field name="monto_pagado" widget="monetary" options="{'currency_field': 'moneda'}"/>
                                <field name="saldo_pendiente" string="Deuda Restante" class="fw-bold text-danger" widget="monetary" options="{'currency_field': 'moneda'}"/>
                            </group>
                            
                            <group string="Soporte de la Compra" class="mt-3">
                                <group>
                                    <field name="referencia_factura" placeholder="Ej: Factura Nro 001-000456, Nota de Entrega..."/>
                                    <field name="asiento_id" invisible="not asiento_id" decoration-bf="1"/>
                                </group>
                            </group>
                            
                            <group string="Configuración de Moneda y Tasa">
                                <group>
                                    <field name="moneda" widget="radio" options="{'horizontal': true}"/>
                                    <field name="moneda_referencia" widget="radio" options="{'horizontal': true}"/>
                                    <button name="action_actualizar_tasa_bcv_manual" type="object" string="Actualizar Tasa" icon="fa-refresh" class="btn btn-sm btn-info"/>
                                </group>
                                <group>
                                    <field name="tasa_aplicada" string="Tasa Activa" readonly="1" force_save="1" decoration-bf="1" decoration-success="1"/>
                                    <field name="usar_tasa_personalizada" widget="boolean_toggle"/>
                                    <field name="tasa_cambio" invisible="not usar_tasa_personalizada" required="usar_tasa_personalizada"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bateria_compra_list" model="ir.ui.view">
        <field name="name">bateria.compra.list</field>
        <field name="model">bateria.compra</field>
        <field name="arch" type="xml">
            <list decoration-info="estado == 'borrador'" decoration-warning="estado == 'confirmado'" decoration-success="estado == 'pagado'" decoration-danger="estado == 'facturado'">
                
                <header>
                    <button name="%(action_bateria_compra_diario_wizard)d" 
                            type="action" 
                            string="🖨️ Imprimir Reporte de Compras" 
                            class="btn-primary" 
                            display="always"/>
                </header>

                <field name="name" string="Referencia"/>
                <field name="fecha"/>
                <field name="proveedor_id"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/> <field name="centro_costo_id" optional="show"/>
                <field name="centro_costo_id" optional="show"/>
                <field name="total_global_usd" string="Total Neto ($)" sum="Total Gastado $" widget="monetary" options="{'currency_symbol': '$'}"/>
                <field name="estado" widget="badge" 
                       decoration-info="estado == 'borrador'" 
                       decoration-warning="estado == 'confirmado'" 
                       decoration-primary="estado == 'recibido'"
                       decoration-danger="estado == 'facturado'"
                       decoration-success="estado == 'pagado'"/>
            </list>
        </field>
    </record>

    <record id="action_bateria_compra" model="ir.actions.act_window">
        <field name="name">Gestión de Compras Corporativas</field>
        <field name="res_model">bateria.compra</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_bateria_proveedor" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">bateria.proveedor</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bateria_compra_item" name="Pedidos de Compra" parent="menu_bateria_compras_root" action="action_bateria_compra" sequence="10"/>
    <menuitem id="menu_bateria_proveedor_item" name="Proveedores" parent="menu_bateria_compras_root" action="action_bateria_proveedor" sequence="20"/>

    <record id="view_bateria_catalogo_lineas_list" model="ir.ui.view">
        <field name="name">bateria.catalogo.lineas.list</field>
        <field name="model">bateria.compra.linea</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="fecha_compra" string="Fecha"/>
                <field name="proveedor_id" string="Proveedor"/>
                <field name="producto_maestro_id" string="Batería" optional="show"/>
                <field name="gasto_id" string="Gasto / Insumo" optional="show"/>
                <field name="descripcion_proveedor" string="Detalle / Descripción"/>
                <field name="precio_usd" string="Costo Pagado ($)" widget="monetary" options="{'currency_symbol': '$'}" decoration-bf="1" decoration-success="1"/>
                <field name="compra_id" string="Factura Ref." optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_bateria_catalogo_historial" model="ir.actions.act_window">
        <field name="name">Historial de Precios y Catálogos</field>
        <field name="res_model">bateria.compra.linea</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_bateria_catalogo_lineas_list"/>
        <field name="domain">[('estado_compra', 'in', ['confirmado', 'recibido', 'facturado', 'pagado'])]</field>
    </record>

    <menuitem id="menu_bateria_proveedor_tarifa" 
              name="Precios y Catálogos" 
              parent="bateria_reportes.menu_bateria_compras_root" 
              action="action_bateria_catalogo_historial" 
              sequence="25"/>

    <record id="action_report_catalogo_proveedores" model="ir.actions.report">
        <field name="name">Catálogo de Productos por Proveedor</field>
        <field name="model">bateria.proveedor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bateria_reportes.reporte_catalogo_proveedores_template</field>
        <field name="report_file">bateria_reportes.reporte_catalogo_proveedores_template</field>
        <field name="binding_model_id" ref="model_bateria_proveedor"/>
        <field name="binding_type">report</field>
    </record>

    <template id="reporte_catalogo_proveedores_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; color: #000;">
                    
                    <div class="text-center mb-4">
                        <h2 style="font-weight: bold; border-bottom: 2px solid #000; padding-bottom: 10px; display: inline-block;">REPORTE DE PRECIOS POR PROVEEDOR</h2>
                        <p class="text-muted">Histórico actualizado al: <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/></p>
                    </div>

                    <t t-foreach="docs" t-as="doc">
                        <t t-set="lineas" t-value="env['bateria.compra.linea'].search([('proveedor_id', '=', doc.id), ('estado_compra', 'in', ['confirmado', 'recibido', 'facturado', 'pagado'])], order='fecha_compra desc, id desc')"/>
                        
                        <t t-if="lineas">
                            <div style="margin-top: 20px; page-break-inside: avoid;">
                                <h5 style="background-color: #e9ecef; padding: 8px; border-left: 4px solid #343a40; font-weight: bold; margin-bottom: 0;">
                                    <span t-esc="doc.nombre_empresa if doc.nombre_empresa else doc.name"/>
                                    <t t-if="doc.rif"><span style="font-size: 11px; color: #666; font-weight: normal;"> (RIF: <span t-esc="doc.rif"/>)</span></t>
                                </h5>
                                
                                <table class="table table-sm table-bordered mt-2">
                                    <thead style="background-color: #343a40; color: white; font-size: 11px;">
                                        <tr>
                                            <th>Producto / Detalle</th>
                                            <th class="text-end" style="width: 25%;">Último Costo ($)</th>
                                            <th class="text-end" style="width: 20%;">Fecha Compra</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-set="productos_vistos" t-value="[]"/>
                                        <tr t-foreach="lineas" t-as="linea">
                                            <t t-set="nombre_prod" t-value="linea.descripcion_proveedor or (linea.producto_maestro_id.nombre if linea.producto_maestro_id else (linea.gasto_id.name if linea.gasto_id else 'Repuesto Vario'))"/>
                                            
                                            <t t-if="nombre_prod not in productos_vistos">
                                                <t t-set="dummy" t-value="productos_vistos.append(nombre_prod)"/>
                                                <tr>
                                                    <td style="vertical-align: middle;"><span t-esc="nombre_prod"/></td>
                                                    <td class="text-end fw-bold" style="vertical-align: middle;">$ <span t-field="linea.precio_usd" t-options='{"widget": "float", "precision": 2}'/></td>
                                                    <td class="text-end text-muted" style="vertical-align: middle;"><span t-field="linea.fecha_compra" t-options='{"widget": "date"}'/></td>
                                                </tr>
                                            </t>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </t>
                    </t>
                    
                    <div class="text-center text-muted mt-5" style="font-size: 10px; border-top: 1px dashed #ccc; padding-top: 10px;">
                        * Los precios mostrados corresponden a la compra más reciente registrada en el historial del sistema para cada artículo.
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>