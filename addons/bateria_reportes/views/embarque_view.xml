<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_bateria_embarque" model="ir.sequence">
        <field name="name">Secuencia de Importaciones</field>
        <field name="code">bateria.embarque.seq</field>
        <field name="prefix">IMP-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="view_bateria_embarque_list" model="ir.ui.view">
        <field name="name">bateria.embarque.list</field>
        <field name="model">bateria.embarque</field>
        <field name="arch" type="xml">
            <list decoration-info="estado == 'borrador'" decoration-warning="estado == 'en_transito'" decoration-success="estado == 'entregado'">
                <field name="name" string="Control Interno" optional="hide"/>
                <field name="referencia_fabrica" string="Ref. Pedido"/>
                <field name="fabrica_id" string="Fábrica/Proveedor"/>
                <field name="bl_booking" string="BL / Booking" decoration-bf="1"/>
                <field name="proveedor_flete_id" string="Naviera" optional="hide"/>
                <field name="fecha_pedido" string="Zarpó el"/>
                <field name="cantidad_contenedores" string="CTNs" sum="Total CTNs"/>
                <field name="total_baterias" string="Total Cantidad" sum="Cantidades"/>
                <field name="peso_toneladas" string="Toneladas (T)" sum="Total Peso"/>
                <field name="estado" widget="badge" decoration-success="estado == 'entregado'" decoration-warning="estado == 'en_transito'"/>
            </list>
        </field>
    </record>

    <record id="view_bateria_embarque_form" model="ir.ui.view">
        <field name="name">bateria.embarque.form</field>
        <field name="model">bateria.embarque</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_en_transito" string="🚢 Informar Zarpe" type="object" class="oe_highlight btn-warning" invisible="estado != 'borrador'"/>
                    <button name="action_recibir_embarque" string="✅ Marcar en Puerto / Recibido" type="object" class="oe_highlight btn-success" invisible="estado != 'en_transito'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,en_transito,entregado"/>
                </header>
                <sheet>
                    
                    <div class="oe_title">
                        <label for="name" string="N° de Control Interno"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    
                    <group>
                        <group string="Datos del Pedido y Fábrica">
                            <field name="fabrica_id" options="{'no_create': True}" placeholder="Ej: VASWORLD POWER CO."/>
                            <field name="referencia_fabrica" placeholder="Ej: SOLICITUD DE PEDIDO Nº1 MARZO 2026"/>
                            <field name="empresa_importadora" widget="selection"/>
                        </group>
                        
                        <group string="Detalles Marítimos">
                            <field name="proveedor_flete_id" options="{'no_create': True}" placeholder="Naviera o Forwarder..."/>
                            <field name="bl_booking" placeholder="Ej: COSU1234567890..."/>
                            <field name="nombre_buque" placeholder="Ej: MSC GULSUN V. 034W"/>
                            <field name="puerto_origen" placeholder="Ej: Ningbo, China"/>
                            <field name="puerto_destino" placeholder="Ej: Puerto Cabello"/>
                        </group>
                    </group>

                    <group>
                        <group string="Control de Tiempos">
                            <field name="fecha_pedido" string="Fecha de Zarpe (ETD)"/>
                            <field name="fecha_llegada_estimada" string="Llegada Estimada (ETA)"/>
                            <field name="fecha_llegada_real" invisible="estado not in ('entregado', 'cancelado')" decoration-bf="1" decoration-success="1"/>
                            <field name="dias_transito" string="Días en el Mar" decoration-danger="dias_transito &gt; 50"/>
                        </group>
                        <group string="Volumen y Capacidad">
                            <field name="cantidad_contenedores"/>
                            <field name="numero_contenedor" placeholder="Ej: TCNU 123456-7..."/>
                            <field name="peso_total_kg" readonly="1" force_save="1" decoration-bf="1"/>
                            <field name="peso_toneladas" readonly="1" force_save="1" decoration-bf="1" decoration-success="1" style="font-size: 16px;"/>
                        </group>
                    </group>

                    <group string="Análisis de Costo Unitario de Importación" style="background-color: #f8f9fa; padding: 10px; border-radius: 5px;">
                        <group>
                            <field name="costo_flete" widget="monetary" options="{'currency_symbol': '$'}" style="font-size: 16px; color: #dc3545;" help="Suma de flete marítimo + gastos aduanales."/>
                        </group>
                        <group>
                            <field name="total_baterias" string="Total Artículos"/>
                            <field name="costo_por_bateria" widget="monetary" options="{'currency_symbol': '$'}" decoration-bf="1" style="font-size: 16px; color: #198754;"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Modelos Importados (Según PDF)">
                            <field name="linea_ids">
                                <list editable="bottom">
                                    <field name="producto_id" options="{'no_create': True}" string="Descripción (Catálogo)"/>
                                    <field name="part_no" optional="show"/>
                                    <field name="unidad_medida" optional="show"/>
                                    <field name="cantidad" sum="Total Cantidad"/>
                                    <field name="peso_unitario_kg"/>
                                    <field name="peso_total_kg" readonly="1" force_save="1" sum="Total KG" decoration-bf="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Novedades / Notas">
                            <field name="notas" placeholder="Anota aquí si hubo rolleo de carga, retrasos en aduana, revisiones, etc..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bateria_embarque" model="ir.actions.act_window">
        <field name="name">Importaciones Marítimas</field>
        <field name="res_model">bateria.embarque</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bateria_embarques_control" 
              name="🚢 Importaciones Marítimas" 
              parent="bateria_reportes.menu_bateria_logistica_root" 
              action="action_bateria_embarque" 
              sequence="2"/>
</odoo>