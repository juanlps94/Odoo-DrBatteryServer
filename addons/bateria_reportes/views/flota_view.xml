<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_reporte_flota_vehiculo" model="ir.actions.report">
        <field name="name">Historial y Gastos del Vehículo</field>
        <field name="model">bateria.vehiculo</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bateria_reportes.reporte_flota_vehiculo_template</field>
        <field name="report_file">bateria_reportes.reporte_flota_vehiculo_template</field>
        <field name="binding_model_id" ref="model_bateria_vehiculo"/>
    </record>

    <template id="reporte_flota_vehiculo_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size: 14px; color: #000;">
                        <div class="text-center mb-4" style="background-color: #343a40; color: white; padding: 10px; border-radius: 5px;">
                            <h2>HISTORIAL OPERATIVO Y DE GASTOS</h2>
                            <h4>PLACA: <span t-field="doc.name"/></h4>
                        </div>
                        
                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Marca y Modelo:</strong> <span t-field="doc.marca_modelo"/><br/>
                                <strong>Año:</strong> <span t-field="doc.ano"/><br/>
                            </div>
                            <div class="col-6 text-end">
                                <strong>Kilometraje Actual:</strong> <span t-field="doc.kilometraje_actual"/> Km<br/>
                                <strong>Costo Total Acumulado:</strong> $ <span t-field="doc.gasto_total" t-options='{"widget": "float", "precision": 2}'/><br/>
                            </div>
                        </div>

                        <h5 style="color: #343a40; border-bottom: 2px solid #343a40; padding-bottom: 5px;">Registro de Operaciones (Combustible / Servicios)</h5>
                        
                        <t t-if="len(doc.servicio_ids) == 0">
                            <div class="alert alert-secondary mt-3 text-center">
                                Este vehículo aún no tiene registros operativos.
                            </div>
                        </t>
                        
                        <t t-if="len(doc.servicio_ids) &gt; 0">
                            <table class="table table-striped table-sm mt-3" style="font-size: 12px;">
                                <thead style="background-color: #f0f0f0; color: #000;">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Operación</th>
                                        <th class="text-end">Km Reg.</th>
                                        <th class="text-end">Recorrido</th>
                                        <th class="text-end">Lts (+)</th>
                                        <th class="text-end text-danger">Lts (-)</th>
                                        <th class="text-end">Costo ($)</th>
                                        <th>Observaciones / Responsable</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="doc.servicio_ids" t-as="serv">
                                        <td><span t-field="serv.fecha" t-options='{"widget": "date"}'/></td>
                                        <td>
                                            <span t-if="serv.tipo_servicio == 'gasolina'">⛽ Gasolina</span>
                                            <span t-if="serv.tipo_servicio == 'mantenimiento'">🔧 Mant.</span>
                                            <span t-if="serv.tipo_servicio == 'extraccion_gasolina'" class="text-danger">⚠️ Extracción</span>
                                        </td>
                                        <td class="text-end"><span t-field="serv.km_actual"/></td>
                                        <td class="text-end text-muted">+<span t-field="serv.km_recorridos"/></td>
                                        
                                        <td class="text-end text-success">
                                            <span t-if="serv.cantidad_litros &gt; 0"><span t-field="serv.cantidad_litros"/> L</span>
                                            <span t-if="serv.cantidad_litros == 0">-</span>
                                        </td>
                                        
                                        <td class="text-end text-danger fw-bold">
                                            <span t-if="serv.litros_extraidos &gt; 0">- <span t-field="serv.litros_extraidos"/> L</span>
                                            <span t-if="serv.litros_extraidos == 0">-</span>
                                        </td>
                                        
                                        <td class="text-end fw-bold"><span t-field="serv.costo_total" t-options='{"widget": "float", "precision": 2}'/></td>
                                        <td>
                                            <span t-if="serv.mecanico">Resp: <span t-field="serv.mecanico"/> | </span>
                                            <span t-field="serv.notas"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            
                            <div class="row justify-content-end mt-2">
                                <div class="col-5">
                                    <table class="table table-sm table-borderless" style="background-color: #e9ecef; border-radius: 5px; padding: 10px;">
                                        <tr>
                                            <td><strong>Balance de Combustible:</strong></td>
                                            <td class="text-end"><strong><span t-field="doc.litros_totales"/> Lts</strong></td>
                                        </tr>
                                        <tr class="border-top" style="font-size: 16px;">
                                            <td><strong>INVERSIÓN TOTAL:</strong></td>
                                            <td class="text-end fw-bold text-danger"><strong>$ <span t-field="doc.gasto_total" t-options='{"widget": "float", "precision": 2}'/></strong></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </t>

                        <div style="page-break-inside: avoid;">
                            <h5 style="color: #343a40; border-bottom: 2px solid #343a40; padding-bottom: 5px; margin-top: 30px;">Soporte de Repuestos (Desde Dpto. Compras)</h5>
                            
                            <t t-if="len(doc.compra_linea_ids) == 0">
                                <p class="text-muted" style="font-size: 12px;">No se han registrado compras directas para este vehículo.</p>
                            </t>
                            
                            <t t-if="len(doc.compra_linea_ids) &gt; 0">
                                <table class="table table-bordered table-sm mt-3" style="font-size: 12px;">
                                    <thead style="background-color: #f8f9fa; color: #000;">
                                        <tr>
                                            <th>Fecha Compra</th>
                                            <th>Ref. Compra</th>
                                            <th>Repuesto / Gasto</th>
                                            <th class="text-center">Cant.</th>
                                            <th class="text-end">Costo ($)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="doc.compra_linea_ids" t-as="compra_linea">
                                            <td><span t-field="compra_linea.fecha_compra" t-options='{"widget": "date"}'/></td>
                                            <td><span t-field="compra_linea.compra_id.name"/></td>
                                            <td><span t-esc="compra_linea.descripcion_proveedor or compra_linea.producto_maestro_id.nombre or compra_linea.gasto_id.name"/></td>
                                            <td class="text-center"><span t-field="compra_linea.cantidad"/></td>
                                            <td class="text-end text-danger fw-bold"><span t-field="compra_linea.subtotal_usd" t-options='{"widget": "float", "precision": 2}'/></td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </div>
                        
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="view_bateria_vehiculo_list" model="ir.ui.view">
        <field name="name">bateria.vehiculo.list</field>
        <field name="model">bateria.vehiculo</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Placa"/>
                <field name="marca_modelo"/>
                <field name="ano"/>
                <field name="kilometraje_actual"/>
                <field name="gasto_total" widget="monetary" options="{'currency_symbol': '$'}"/>
            </list>
        </field>
    </record>

    <record id="view_bateria_vehiculo_form" model="ir.ui.view">
        <field name="name">bateria.vehiculo.form</field>
        <field name="model">bateria.vehiculo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_reporte_flota_vehiculo)d" type="action" string="🖨️ Imprimir Historial Completo" class="oe_highlight btn-dark"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Placa del Vehículo"/>
                        <h1><field name="name" placeholder="Ej: AB123CD"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="marca_modelo"/>
                            <field name="ano"/>
                        </group>
                        <group>
                            <field name="kilometraje_actual"/>
                            <field name="gasto_total" widget="monetary" options="{'currency_symbol': '$'}"/>
                            <field name="litros_totales" string="Balance de Combustible (Lts)"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Historial de Operaciones">
                            <field name="servicio_ids">
                                <list decoration-info="tipo_servicio=='gasolina'" decoration-warning="tipo_servicio=='mantenimiento'" decoration-danger="tipo_servicio=='extraccion_gasolina'">
                                    <field name="fecha"/>
                                    <field name="tipo_servicio"/>
                                    <field name="km_actual"/>
                                    <field name="cantidad_litros" string="Lts (+)"/>
                                    <field name="litros_extraidos" string="Lts (-)"/>
                                    <field name="mecanico" optional="show"/>
                                    <field name="costo_total" widget="monetary" options="{'currency_symbol': '$'}"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Repuestos Comprados (Desde Compras)">
                            <field name="compra_linea_ids" readonly="1">
                                <list decoration-muted="estado_compra == 'cancelado'">
                                    <field name="fecha_compra" string="Fecha"/>
                                    <field name="compra_id" string="Ref. Compra"/>
                                    <field name="proveedor_id"/>
                                    <field name="descripcion_proveedor" string="Repuesto / Insumo"/>
                                    <field name="cantidad"/>
                                    <field name="subtotal_usd" string="Costo ($)" sum="Costo Total Compras" widget="monetary" options="{'currency_symbol': '$'}" decoration-bf="1" decoration-danger="1"/>
                                    <field name="estado_compra" widget="badge" decoration-success="estado_compra == 'pagado'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bateria_servicio_vehiculo_list" model="ir.ui.view">
        <field name="name">bateria.servicio.vehiculo.list</field>
        <field name="model">bateria.vehiculo.servicio</field>
        <field name="arch" type="xml">
            <list decoration-info="tipo_servicio=='gasolina'" decoration-warning="tipo_servicio=='mantenimiento'" decoration-danger="tipo_servicio=='extraccion_gasolina'">
                <field name="fecha"/>
                <field name="vehiculo_id"/>
                <field name="tipo_servicio"/>
                <field name="km_recorridos" optional="show"/>
                <field name="cantidad_litros" string="Lts (+)"/>
                <field name="litros_extraidos" string="Lts (-)"/>
                <field name="mecanico" optional="show"/>
                <field name="costo_total" widget="monetary" options="{'currency_symbol': '$'}"/>
            </list>
        </field>
    </record>
    
    <record id="view_bateria_servicio_vehiculo_form" model="ir.ui.view">
        <field name="name">bateria.servicio.vehiculo.form</field>
        <field name="model">bateria.vehiculo.servicio</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="vehiculo_id"/>
                            <field name="fecha"/>
                            <field name="tipo_servicio" widget="radio"/>
                        </group>
                        <group>
                            <field name="km_anterior"/>
                            <field name="km_actual"/>
                            <field name="km_recorridos" readonly="1" force_save="1"/>
                        </group>
                        <group>
                            <field name="cantidad_litros" invisible="tipo_servicio != 'gasolina'" required="tipo_servicio == 'gasolina'"/>
                            <field name="litros_extraidos" invisible="tipo_servicio != 'extraccion_gasolina'" required="tipo_servicio == 'extraccion_gasolina'"/>
                            <field name="mecanico" invisible="tipo_servicio != 'extraccion_gasolina'" required="tipo_servicio == 'extraccion_gasolina'"/>
                            <field name="costo_total" widget="monetary" options="{'currency_symbol': '$'}" invisible="tipo_servicio == 'extraccion_gasolina'"/>
                        </group>
                    </group>
                    <field name="notas" placeholder="Detalles, estación de servicio, motivo de extracción..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bateria_vehiculo" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">bateria.vehiculo</field>
        <field name="view_mode">list,form</field> 
    </record>
    
    <record id="action_bateria_servicio_vehiculo" model="ir.actions.act_window">
        <field name="name">Servicios y Gasolina</field>
        <field name="res_model">bateria.vehiculo.servicio</field>
        <field name="view_mode">list,form</field> 
    </record>

<menuitem id="menu_bateria_flota_root" 
              name="Flota" 
              parent="bateria_reportes.menu_bateria_root" 
              sequence="60"/>

    <menuitem id="menu_bateria_vehiculos" 
              name="Vehículos" 
              parent="menu_bateria_flota_root" 
              action="action_bateria_vehiculo" 
              sequence="10"/>

    <menuitem id="menu_bateria_servicios_flota" 
              name="⛽ Operaciones y Gasolina" 
              parent="menu_bateria_flota_root" 
              action="action_bateria_servicio_vehiculo" 
              sequence="20"/>
</odoo>