<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bateria_activo_list" model="ir.ui.view">
        <field name="name">bateria.activo.list</field>
        <field name="model">bateria.activo</field>
        <field name="arch" type="xml">
            <list decoration-danger="estado=='desincorporado'" decoration-warning="estado=='mantenimiento'">
                <field name="name"/>
                <field name="categoria"/>
                <field name="fecha_adquisicion"/>
                <field name="valor_compra"/>
                <field name="compra_id"/>
                <field name="estado" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_bateria_activo_form" model="ir.ui.view">
        <field name="name">bateria.activo.form</field>
        <field name="model">bateria.activo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej. Computadora Dell Optiplex"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="categoria"/>
                            <field name="estado"/>
                        </group>
                        <group>
                            <field name="fecha_adquisicion"/>
                            <field name="valor_compra"/>
                            <field name="compra_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bateria_activo" model="ir.actions.act_window">
        <field name="name">Inventario de Activos</field>
        <field name="res_model">bateria.activo</field>
        <field name="view_mode">list,form</field> </record>

    <menuitem id="menu_bateria_activos" name="Activos Fijos" parent="bateria_reportes.menu_bateria_inventario_root" action="action_bateria_activo" sequence="50"/>
</odoo>