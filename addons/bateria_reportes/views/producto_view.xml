<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Agregar desde CSV -->
    <record id="action_bateria_serial_import_wizard" model="ir.actions.act_window">
        <field name="name">Subir Seriales CSV</field>
        <field name="res_model">bateria.serial.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_bateria_serial_import_wizard_form" model="ir.ui.view">
        <field name="name">bateria.serial.import.wizard.form</field>
        <field name="model">bateria.serial.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Carga Masiva de Seriales">
                <div class="alert alert-info" role="alert">
                    <strong>¡Atención!</strong> El archivo CSV debe tener los siguientes títulos en la primera fila: <b>Producto, Nombre, Estado, Ubicacion</b>
                </div>
                <group>
                    <field name="producto_id" readonly="1" force_save="1" options="{'no_open': True}"/>
                    <field name="archivo" filename="nombre_archivo"/>
                    <field name="nombre_archivo" invisible="1"/>
                </group>
                <footer>
                    <button string="🚀 Cargar Seriales" name="action_importar_seriales" type="object" class="btn-success"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_bateria_serial_list" model="ir.ui.view">
        <field name="name">bateria.serial.list</field>
        <field name="model">bateria.serial</field>
        <field name="arch" type="xml">
            <list editable="top" decoration-success="estado=='disponible'" decoration-muted="estado=='vendido'">
                <field name="nombre" placeholder="Escanea o escribe el serial..."/>
                <field name="producto_id" options="{'no_create': True}" placeholder="Modelo..."/>
                
                <field name="fecha_ingreso" string="Ingresó"/>
                <field name="fecha_vencimiento" string="Vence el" decoration-bf="1" decoration-danger="1"/>
                
                <field name="ubicacion_id" options="{'no_create': True}" placeholder="¿A qué almacén entra?"/>
                <field name="estado" readonly="1" widget="badge" decoration-success="estado == 'disponible'" decoration-warning="estado == 'vendido'"/>
                <field name="orden_venta_id" readonly="1" optional="hide" string="Factura de Venta"/>
            </list>
        </field>
    </record>

    <record id="action_bateria_serial" model="ir.actions.act_window">
        <field name="name">Carga de Baterías (Seriales)</field>
        <field name="res_model">bateria.serial</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_bateria_serial_ingreso" name="Ingresar Baterías (Seriales)" parent="bateria_reportes.menu_bateria_logistica_root" action="action_bateria_serial" sequence="5"/>

    <!-- Pagina principal del catalogo -->
    <record id="view_bateria_producto_tree" model="ir.ui.view">
        <field name="name">bateria.producto.tree</field>
        <field name="model">bateria.producto</field>
        <field name="arch" type="xml">
            <list>
                <field name="nombre"/>
                <field name="requiere_serial" widget="boolean_toggle" string="Es Batería (Usa Serial)"/>
                
                <field name="stock_actual" decoration-danger="stock_actual &lt; 5" decoration-success="stock_actual &gt;= 5" widget="badge"/>
                
                <field name="stock_racksito" string="En Racksito" widget="badge" decoration-success="1"/>
                <field name="stock_galpon" string="En Galpón" widget="badge" decoration-warning="1" optional="show"/>
                
                <field name="precio_base_usd" string="Precio ($)" widget="monetary" options="{'currency_symbol': '$'}"/>
                <field name="precio_bs" string="Ref (Bs)" widget="monetary" options="{'currency_symbol': 'Bs'}"/>
                
                <field name="codigo_rfid"/>
            </list>
        </field>
    </record>

    <!-- Fin de la vista Pagina principal del catalogo -->


    <!-- Vista Catalogo dentro de una bateria -->
    <record id="view_bateria_producto_form" model="ir.ui.view">
        <field name="name">bateria.producto.form</field>
        <field name="model">bateria.producto</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="%(action_bateria_serial_import_wizard)d" 
                            type="action" 
                            string="📂 Subir Seriales CSV" 
                            class="btn-success" 
                            context="{'default_producto_id': id}"
                            invisible="not requiere_serial"/>
                    <button name="action_abrir_wizard_fechas" type="object" string="🛠️ Corregir Fechas" class="btn-warning" groups="base.group_erp_manager"/>
                            
                </header>
                <sheet>
                <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-battery-full" style="pointer-events: none;">
                            <div class="o_stat_info">
                                <span class="o_stat_value text-success">
                                    <field name="stock_actual"/>
                                </span>
                                <span class="o_stat_text">Disponibles</span>
                            </div>
                        </button>
                    </div>
                    <field name="imagen" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="nombre" string="Nombre del Producto"/>
                        <h1><field name="nombre" readonly="0"  placeholder="Ej: Batería 700 Amp o Terminal de Ojal"/></h1>
                    </div>
                    <group>
                        <group string="Configuración del Producto">
                            <field name="requiere_serial" widget="boolean_toggle"/>
                            <field name="codigo_rfid"/>
                            <field name="stock_minimo"/>

                            <hr colspan="2" style="margin:0; padding:0;"/>
                            <field name="stock_actual" decoration-success="stock_actual &gt;= stock_minimo" decoration-danger="stock_actual &lt; stock_minimo" style="font-size: 15px; font-weight: bold;"/>
                            <field name="stock_racksito" invisible="not requiere_serial" string="└ En Racksito"/>
                            <field name="stock_galpon" invisible="not requiere_serial" string="└ En Galpón"/>
                        </group>
                        <group string="Precios">
                            <field name="precio_base_usd" string="Precio Base ($)" widget="monetary" options="{'currency_symbol': '$'}" style="color: green; font-weight: bold; font-size: 16px;"/>
                            
                            <label for="tasa_usdt_actual" string="Tasa USDT Aplicada"/>
                            <div class="o_row">
                                <field name="tasa_usdt_actual" readonly="1" class="oe_inline fw-bold text-primary"/>
                                <button name="action_actualizar_tasas_desde_producto" type="object" icon="fa-refresh" class="btn btn-sm btn-info" title="Traer Tasa USDT de Binance P2P"/>
                            </div>
                            
                            <field name="precio_bs" string="Referencia Bs" widget="monetary" options="{'currency_symbol': 'Bs'}" style="font-size: 15px;"/>
                        </group>
                    </group>
                    <notebook>
                        
                        <page string="Historial de Seriales" invisible="not requiere_serial">
                            
                        <!-- <field name="serial_ids" widget="many2many_tags" placeholder="Buscar serial..."/> -->
                   
                            <field name="serial_ids" context="{'default_producto_id': id}">
                                <list editable="bottom" decoration-success="estado=='disponible'" decoration-muted="estado=='vendido'">
                                    <field name="nombre" placeholder="Ingresa el serial aquí..." string="Serial"/>
                                    <field name="fecha_ingreso" string="Ingresó"/>
                                    <field name="fecha_vencimiento" string="Vence el" decoration-bf="1" decoration-danger="1"/>
                                    <field name="ubicacion_id" required="1" options="{'no_create': True}" string="Ubicación Actual"/>
                                    <field name="estado" readonly="1" widget="badge" decoration-success="estado == 'disponible'" decoration-warning="estado == 'vendido'"/>
                                    <field name="orden_venta_id" readonly="1" optional="show" string="Factura de Venta"/>
                                </list>
                            </field>
                            
                        </page>

                        <page string="Ingreso de Mercancía (Stock)" invisible="requiere_serial">
                            <p class="text-muted" style="margin-bottom: 15px; font-size: 13px;">
                                <i class="fa fa-info-circle"/> <strong>Venta por Cantidad:</strong> Agrega líneas aquí para registrar el ingreso manual de stock. Cuando factures este producto, las cantidades se restarán automáticamente mostrando "Salida" en el historial.
                            </p>
                            <field name="movimiento_ids" context="{'default_producto_id': id, 'default_tipo_movimiento': 'entrada'}">
                                <list editable="bottom" decoration-success="tipo_movimiento == 'entrada'" decoration-danger="tipo_movimiento == 'salida'">
                                    <field name="fecha" string="Fecha"/>
                                    <field name="tipo_movimiento" string="Operación" required="1"/>
                                    <field name="cantidad" string="Cantidad" required="1"/>
                                    <field name="ubicacion_id" string="Almacén" options="{'no_create': True}" required="1"/>
                                    <field name="nota" string="Nota / Justificación" placeholder="Ej: Compra de lote nuevo..."/>
                                    <field name="orden_venta_id" string="Factura" readonly="1" optional="show"/>
                                </list>
                            </field>
                        </page>

                        <page string="Reglas de Precio">
                            <field name="tarifa_ids">
                                <list editable="bottom">
                                    <field name="tarifa_id"/>
                                    <field name="precio" widget="monetary" options="{'currency_field': 'moneda'}"/>
                                    <field name="moneda"/>
                                </list>
                            </field>
                        </page>
                        
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

 <!-- Fin del vista Catalogo dentro de una bateria -->

    <record id="action_bateria_producto" model="ir.actions.act_window">
        <field name="name">Catálogo de Productos</field>
        <field name="res_model">bateria.producto</field>
        <field name="view_mode">list,form</field>
    </record>



    <menuitem id="menu_bateria_productos" name="Productos" parent="menu_bateria_productos_root" action="action_bateria_producto" sequence="10"/>

    <record id="view_bateria_update_date_wizard_form" model="ir.ui.view">
        <field name="name">bateria.update.date.wizard.form</field>
        <field name="model">bateria.update.date.wizard</field>
        <field name="arch" type="xml">
            <form string="Corregir Fechas de Ingreso">
                <div class="alert alert-warning" role="alert">
                    Este asistente buscará todos los seriales de este modelo ingresados en la <b>Fecha Errónea</b> y los actualizará a la <b>Fecha Correcta</b>. También recalculará sus meses de vida útil automáticamente.
                </div>
                <group>
                    <field name="producto_id"/>
                    <field name="fecha_erronea"/>
                    <field name="fecha_correcta"/>
                </group>
                <footer>
                    <button name="action_actualizar_fechas" type="object" string="Aplicar Corrección" class="oe_highlight btn-success"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_bateria_reporte_stock_wizard_form" model="ir.ui.view">
        <field name="name">bateria.reporte.stock.wizard.form</field>
        <field name="model">bateria.reporte.stock.wizard</field>
        <field name="arch" type="xml">
            <form string="Reporte de Inventario de Baterías">
                <div class="alert alert-info" role="alert">
                    Este reporte generará un PDF con todas las baterías <b>Disponibles</b>, agrupadas por modelo, mostrando su serial y fecha de vencimiento.
                </div>
                <group>
                    <field name="ubicacion_id" options="{'no_create': True}" placeholder="Ej: Racksito..."/>
                </group>
                <footer>
                    <button name="action_imprimir_reporte" type="object" string="🖨️ Generar PDF" class="oe_highlight btn-success"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bateria_reporte_stock" model="ir.actions.act_window">
        <field name="name">Reporte de Inventario</field>
        <field name="res_model">bateria.reporte.stock.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bateria_reporte_stock" name="📊 Reporte de Inventario" parent="bateria_reportes.menu_bateria_logistica_root" action="action_bateria_reporte_stock" sequence="50"/>

    <record id="action_report_stock_baterias" model="ir.actions.report">
        <field name="name">Inventario de Baterías (Stock)</field>
        <field name="model">bateria.reporte.stock.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">bateria_reportes.reporte_stock_baterias_template</field>
        <field name="report_file">bateria_reportes.reporte_stock_baterias_template</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="reporte_stock_baterias_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px;">
                    <t t-foreach="docs" t-as="wizard">
                        
                        <div class="text-center mb-4">
                            <h2 style="font-weight: bold; color: #000;">REPORTE DE INVENTARIO DISPONIBLE</h2>
                            <p style="font-size: 14px;" t-if="wizard.ubicacion_id">
                                <strong>Almacén:</strong> <span t-field="wizard.ubicacion_id.name"/>
                            </p>
                            <p style="font-size: 14px;" t-else="">
                                <strong>Almacén:</strong> TODOS
                            </p>
                            <p style="font-size: 12px;" class="text-muted">Generado el <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %I:%M %p')"/></p>
                        </div>

                        <t t-set="domain" t-value="[('estado', '=', 'disponible')]"/>
                        <t t-if="wizard.ubicacion_id">
                            <t t-set="domain" t-value="[('estado', '=', 'disponible'), ('ubicacion_id', '=', wizard.ubicacion_id.id)]"/>
                        </t>
                        <t t-set="seriales" t-value="env['bateria.serial'].search(domain, order='producto_id asc, fecha_vencimiento asc')"/>
                        
                        <t t-set="productos_ids" t-value="seriales.mapped('producto_id')"/>

                        <t t-foreach="productos_ids" t-as="prod">
                            <t t-set="seriales_prod" t-value="seriales.filtered(lambda s: s.producto_id.id == prod.id)"/>
                            
                            <h4 class="mt-4" style="border-bottom: 2px solid #333; padding-bottom: 5px;">
                                <span t-field="prod.nombre"/> 
                                <span class="badge rounded-pill text-bg-success float-end" style="font-size: 14px; background-color: #198754; color: white; padding: 5px 10px;">
                                    Total: <t t-esc="len(seriales_prod)"/> unid.
                                </span>
                            </h4>
                            
                            <table class="table table-sm table-bordered mt-2">
                                <thead style="background-color: #f0f0f0;">
                                    <tr class="text-center">
                                        <th style="width: 5%;">#</th>
                                        <th style="width: 35%;">Número de Serial</th>
                                        <th style="width: 25%;">Almacén / Ubicación</th>
                                        <th style="width: 20%;">Ingresó el</th>
                                        <th style="width: 15%;">Vence el</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-set="contador" t-value="1"/>
                                    <tr t-foreach="seriales_prod" t-as="serial">
                                        <td class="text-center"><t t-esc="contador"/></td>
                                        <td class="fw-bold"><span t-field="serial.nombre"/></td>
                                        <td><span t-field="serial.ubicacion_id.name"/></td>
                                        <td class="text-center"><span t-field="serial.fecha_ingreso" t-options='{"widget": "date"}'/></td>
                                        <td class="text-center text-danger fw-bold"><span t-field="serial.fecha_vencimiento" t-options='{"widget": "date"}'/></td>
                                        <t t-set="contador" t-value="contador + 1"/>
                                    </tr>
                                </tbody>
                            </table>
                        </t>

                        <div t-if="not seriales" class="alert alert-warning text-center mt-5" style="border: 1px solid #ffc107; padding: 15px;">
                            No hay baterías disponibles actualmente en el inventario seleccionado.
                        </div>
                        
                        <div class="row mt-5" t-if="seriales">
                            <div class="col-12 text-end">
                                <h3 class="fw-bold" style="border-top: 2px dashed #000; padding-top: 10px;">GRAN TOTAL: <span style="color: #198754;"><t t-esc="len(seriales)"/> Baterías</span></h3>
                            </div>
                        </div>

                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>

