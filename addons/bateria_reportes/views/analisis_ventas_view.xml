<odoo>
    <!-- LISTA -->
    <record id="view_analisis_ventas_list" model="ir.ui.view">
        <field name="name">bateria.analisis.ventas.tree</field>
        <field name="model">bateria.analisis.ventas</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha_entrega"/>
                <field name="pedido_numero"/>
                <field name="comercial"/>
                <field name="equipo_ventas"/>
                <field name="compania"/>
                <field name="total"/>
            </list>
        </field>
    </record>

    <!-- FORMULARIO -->
    <record id="view_analisis_ventas_form" model="ir.ui.view">
        <field name="name">bateria.analisis.ventas.form</field>
        <field name="model">bateria.analisis.ventas</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="fecha_entrega"/>
                        <field name="pedido_numero"/>
                        <field name="comercial"/>
                        <field name="equipo_ventas"/>
                        <field name="compania"/>
                        <field name="total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="action_analisis_ventas" model="ir.actions.act_window">
        <field name="name">Análisis de Ventas</field>
        <field name="res_model">bateria.analisis.ventas</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
