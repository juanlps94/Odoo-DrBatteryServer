<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_bateria_recepcion_list" model="ir.ui.view">
        <field name="name">bateria.recepcion.list</field>
        <field name="model">bateria.recepcion</field>
        <field name="arch" type="xml">
            <list decoration-success="estado == 'hecho'" decoration-info="estado == 'listo'">
                <field name="name" string="Albarán"/>
                <field name="compra_id"/>
                <field name="proveedor_id"/>
                <field name="fecha"/>
                <field name="ubicacion_id"/>
                <field name="estado" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_bateria_recepcion_form" model="ir.ui.view">
        <field name="name">bateria.recepcion.form</field>
        <field name="model">bateria.recepcion</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_validar_recepcion" string="Validar Entrada" type="object" class="oe_highlight" invisible="estado != 'listo'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="listo,hecho"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Albarán de Recepción"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="compra_id"/>
                            <field name="proveedor_id"/>
                        </group>
                        <group>
                            <field name="fecha" readonly="estado == 'hecho'"/>
                            <field name="ubicacion_id" readonly="estado == 'hecho'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Operaciones y Seriales">
                            <field name="linea_ids" readonly="estado == 'hecho'">
                                <list editable="bottom">
                                    <field name="producto_id" readonly="1" force_save="1"/>
                                    <field name="cantidad_demandada" readonly="1" force_save="1"/>
                                    <field name="seriales_escaneados" placeholder="Dispara la pistola aquí..."/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bateria_recepcion" model="ir.actions.act_window">
        <field name="name">Recepciones / Albaranes</field>
        <field name="res_model">bateria.recepcion</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_bateria_recepciones" name="Recepciones" parent="bateria_reportes.menu_bateria_logistica_root" action="action_bateria_recepcion" sequence="15"/>
</odoo>