<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bateria_taller_articulo_list" model="ir.ui.view">
        <field name="name">bateria.taller.articulo.list</field>
        <field name="model">bateria.taller.articulo</field>
        <field name="arch" type="xml">
            <list>
                <field name="codigo"/>
                <field name="gama"/>
                <field name="name"/>
                <field name="unidades_caja"/>
                <field name="presentacion"/>
                <field name="pvp_detal_taller"/>
                <field name="pvp_instituciones"/>
            </list>
        </field>
    </record>

    <record id="view_bateria_taller_articulo_form" model="ir.ui.view">
        <field name="name">bateria.taller.articulo.form</field>
        <field name="model">bateria.taller.articulo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="codigo"/>
                            <field name="name"/>
                            <field name="gama"/>
                        </group>
                        <group>
                            <field name="unidades_caja"/>
                            <field name="presentacion"/>
                            <field name="pvp_detal_taller"/>
                            <field name="pvp_instituciones"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bateria_taller_articulo" model="ir.actions.act_window">
        <field name="name">Catálogo Taller Dr. Battery</field>
        <field name="res_model">bateria.taller.articulo</field>
        <field name="view_mode">list,form</field> </record>

    <menuitem id="menu_bateria_taller_root" name="Taller (Dr. Battery)" parent="bateria_reportes.menu_bateria_root" action="action_bateria_taller_articulo" sequence="70"/>
</odoo>