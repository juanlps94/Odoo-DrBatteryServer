<odoo>

    <record id="view_bateria_pago_list" model="ir.ui.view">
        <field name="name">bateria.pago.list</field>
        <field name="model">bateria.pago</field>
        <field name="arch" type="xml">
            <list>
                <field name="fecha_pago"/>
                <field name="orden_venta_id"/>
                <field name="monto"/>
                <field name="moneda"/>
                <field name="tipo_pago"/>
                <field name="referencia_banco"/> 
                <field name="banco"/>
                <field name="monto_usd" widget="monetary" options="{'currency_symbol': '$'}"/>
                <field name="monto_bs" widget="monetary" options="{'currency_symbol': 'Bs'}"/>
            </list>
        </field>
    </record>

    <record id="view_bateria_pago_form" model="ir.ui.view">
        <field name="name">bateria.pago.form</field>
        <field name="model">bateria.pago</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="orden_venta_id"/>
                            <field name="fecha_pago"/>
                            <field name="monto"/>
                            <field name="moneda"/>
                            <field name="tasa_cambio" invisible="moneda != 'bs'"/>
                        </group>
                        <group>
                            <field name="tipo_pago"/>
                            
                            <field name="banco" 
                                   invisible="tipo_pago not in ('pago_movil', 'zelle', 'cashea')"/>
                                   
                            <field name="referencia_banco" 
                                   invisible="tipo_pago == 'efectivo'"/>
                                   
                            <field name="serial_billetes" 
                                   invisible="tipo_pago != 'efectivo' or moneda != 'usd'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>