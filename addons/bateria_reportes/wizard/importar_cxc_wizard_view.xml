<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_bateria_importar_cxc_wizard_form" model="ir.ui.view">
        <field name="name">bateria.importar.cxc.wizard.form</field>
        <field name="model">bateria.importar.cxc.wizard</field>
        <field name="arch" type="xml">
            <form string="Importar Cuentas por Cobrar">
                <div class="alert alert-info" role="alert">
                    <strong>Instrucciones:</strong> Sube un archivo de Excel guardado como <b>CSV UTF-8 (delimitado por comas)</b>.<br/>
                    La primera fila de tu Excel debe tener <b>EXACTAMENTE</b> estos 5 títulos en mayúscula:<br/><br/>
                    <code>CLIENTE,RIF,FECHA,REFERENCIA,MONTO</code><br/><br/>
                    <em>* Fecha en formato YYYY-MM-DD. Montos usando el punto para decimales (Ej: 130.50).</em>
                </div>
                <group>
                    <field name="nombre_archivo" invisible="1"/>
                    <field name="archivo" filename="nombre_archivo" widget="binary"/>
                </group>
                <footer>
                    <button name="action_importar" string="Importar y Cargar Deudas" type="object" class="oe_highlight" icon="fa-upload"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bateria_importar_cxc_wizard" model="ir.actions.act_window">
        <field name="name">Importar CxC desde Excel</field>
        <field name="res_model">bateria.importar.cxc.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_bateria_importar_cxc"
              name="📥 Importar CxC (Excel)"
              parent="bateria_reportes.menu_bateria_ventas_root"
              action="action_bateria_importar_cxc_wizard"
              sequence="21"/>
</odoo>